diff --git a/port/runtime/host/pad_mods.cpp b/port/runtime/host/pad_mods.cpp
new file mode 100644
index 0000000..2d39725
--- /dev/null
+++ b/port/runtime/host/pad_mods.cpp
@@ -0,0 +1,2038 @@
+// Vooby Mods (training input mods). See pad_mods.h.
+//
+// WHO IT APPLIES TO
+// lcancel::observe hands over the human fighters this PC drives. Offline it is filed per
+// controller port (pad_port, StaticPlayer 0x48), so a mod follows the controller whatever player
+// slot it picked, and CPUs are never touched. Online only the local player's fighter is in it, and
+// the native game files it under its player slot, which need not be the port the controller is read
+// from (mu_online.input_source): there the one local fighter drives every connected local pad.
+//
+// TIMING
+// Online (and with offline delay) a pad reaches the game `delay` frames after it is read, and the
+// fighter state seen here is older still. So no step waits to see what the last one did: every
+// move is a run of frames with fixed gaps from its first press, which a delay shifts as a whole
+// without changing the gaps the game needs. The state only decides whether to start, and, where a
+// move must know what happened (Z grab, the wavedash's jump), it is read `delay + 1` frames after
+// the press it is about.
+//
+// LIKE A PLAYER
+// What the mods add should read as the player's own presses, in the input display, the replay and
+// the other players' games: their own button held back to the right frame rather than another one,
+// a press held like a finger rather than a one-frame blip, and (human timing, on by default) a
+// frame or so of variation inside each move's working window, a stick that passes through a
+// halfway position instead of jumping, and every value inside a normal controller's range.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "pad_mods.h"
+#include "gameplay_policy.h"
+#include "lcancel.h"
+#include "render_options.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <cmath>
+#include <cstring>
+#include <random>
+#include <string>
+
+#ifdef MELEE_NO_SLIPPI
+#include "netplay_state.h"
+#else
+#include "slippi_online.h"
+#endif
+
+namespace pad_mods {
+namespace {
+
+// ---- GameCube pad bits
+constexpr uint16_t kPadZ = 0x0010, kPadR = 0x0020, kPadL = 0x0040, kPadA = 0x0100, kPadB = 0x0200,
+                   kPadX = 0x0400, kPadY = 0x0800;
+
+// ---- ftCommon_MotionState ids (melee/src/melee/ft/kinds/ftCommon/forward.h; the enum count there
+// starts one high: Wait is 14, KneeBend 24, Catch 0xD4, which match Melee's own numbers)
+constexpr int32_t kKneeBend = 24;                      // jumpsquat
+// Grounded states that take a jump: Wait .. RunBrake (14..23: walks, turn, dash, run),
+// Squat .. SquatRv (39..41), Landing (42, once its lag is over), GuardOn, Guard (0xB2, 0xB3).
+constexpr int32_t kWait = 14, kRunBrake = 23, kSquat = 39, kLanding = 42, kGuardOn = 0xB2, kGuard = 0xB3;
+constexpr int32_t kOttotto = 245;   // teeter (246 OttottoWait)
+constexpr int32_t kCatchFirst = 0xD4, kCatchLast = 0xD8;   // Catch .. CatchWait: a grab has started
+// Fox's grounded down-B states (ftFx_MS_SpecialLwStart .. SpecialLwTurn = ftCo_MS_Count 341 + 19 ..
+// + 23, melee/src/melee/ft/kinds/ftFox/forward.h); Falco's table uses the same ids. Only the Loop
+// takes a jump (ftFx_SpecialLwLoop_IASA; Start, Hit, Turn and End have empty IASA).
+constexpr int32_t kShineFirst = 360, kShineLoop = 361, kShineLast = 364;
+// The aerial ones (SpecialAirLwStart .. SpecialAirLwTurn): its Loop takes a double jump
