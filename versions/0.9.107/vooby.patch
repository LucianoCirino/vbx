+// The fighter table the L-cancel helper and the training input mods read. The game library's
+// lcancel_view files each human fighter under Player_GetSubColor (the tint index, 0 for nearly
+// everyone) instead of its controller, and has no character or facing. Fixing that inside the
+// library would mean shipping a library built here, and a library built with another compiler
+// simulates a hair differently and desyncs online against the release. So the host corrects it from
+// what the release library already answers: each entry's slot -> MU_PRACTICE_GET_PLAYER (pad_port,
+// CharacterKind) and the state snapshot (facing_dir). Online the library's own filing is kept (the
+// mods use the one local fighter there).
+static void native_fighter_view(MuLcancelView* out) {
+  if (!g_game.lcancel_view) return;
+  MuLcancelView raw{};
+  g_game.lcancel_view(&raw);
+  *out = raw;
+  if (!g_game.practice) return;
+  MuStatePod pod{};
+  if (g_game.state_snapshot) g_game.state_snapshot(&pod);
+  const bool online = slippi::online::session_mode() >= 0;
+  if (!online)
+    for (int p = 0; p < 4; ++p) { out->port[p] = MuLcancelFighter{}; out->fighter_kind[p] = 0; out->facing[p] = 0.0f; out->vel_x[p] = 0.0f; }
+  for (int p = 0; p < 4; ++p) {
+    const MuLcancelFighter& f = raw.port[p];
+    if (!f.present || f.slot < 0 || f.slot > 3) continue;
+    int32_t a[9] = {f.slot, 0, 0, 0, 0, 0, 0, 0, 0};
+    if (g_game.practice(MU_PRACTICE_GET_PLAYER, a, 9) != 0) { if (!online) out->port[p] = f; continue; }
+    const int port = online ? p : (a[5] & 3);   // pad_port: the controller that drives this fighter
+    if (!online && out->port[port].present) continue;
+    out->port[port] = f;
+    // CharacterKind (melee/src/melee/ft/forward.h) -> the Ft_Kind + 1 the mods read (they need it
+    // for Fox/Falco moves and every fighter's jumpsquat length); unknown kinds read as 0x7F.
+    static const int8_t kCKindToFtKind[0x1A] = {
+        0x02, 0x03, 0x01, 0x18, 0x04, 0x05, 0x06, 0x11, 0x00, 0x12, 0x10, 0x08, 0x09,
+        0x0C, 0x0A, 0x0F, 0x0D, 0x0E, 0x13, 0x07, 0x16, 0x14, 0x15, 0x1A, 0x17, 0x19};
+    const int32_t ckind = a[2];
+    out->fighter_kind[port] = (ckind >= 0 && ckind < 0x1A) ? kCKindToFtKind[ckind] + 1 : 0x7F;
+    float facing = 0.0f;
+    if (pod.player[f.slot].present) std::memcpy(&facing, &pod.player[f.slot].facing, sizeof facing);
+    out->facing[port] = facing;
+    float vel = 0.0f;
+    if (pod.player[f.slot].present) std::memcpy(&vel, &pod.player[f.slot].vel_x, sizeof vel);
+    out->vel_x[port] = vel;
+  }
+}
