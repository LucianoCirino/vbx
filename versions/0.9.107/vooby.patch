diff --git a/port/tests/pad_mods_test.cpp b/port/tests/pad_mods_test.cpp
new file mode 100644
index 0000000..84b95f0
--- /dev/null
+++ b/port/tests/pad_mods_test.cpp
@@ -0,0 +1,1222 @@
+// Training input mods as fixed frame sequences (so input delay cannot break them); they follow the
+// local fighter; offline, Direct and Teams only.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "pad_mods.h"
+#include "gameplay_policy.h"
+#include "lcancel.h"
+#include "lcancel_policy.h"
+#include "render_options.h"
+#include <cstdio>
+#include <cmath>
+#include <cstring>
+
+namespace {
+uint32_t tick = 1;
+MuLcancelView view{};
+int network_mode = -1;
+int local_slot = 0;
+int online_delay = 2;
+void native_view(MuLcancelView* out) { *out = view; }
+}
+namespace host {
+uint32_t retrace_count() { return tick; }
+uint32_t rd32(uint32_t) { return 0; }
+uint8_t rd8(uint32_t) { return 0; }
+void log(const char*, ...) {}
+}
+namespace slippi::online {
+int session_mode() { return network_mode; }
+int local_player_index() { return local_slot; }
+bool in_online_menus() { return false; }
+int match_input_delay() { return network_mode >= 0 ? online_delay : 0; }
+}
+namespace gx {
+void set_owner_tracking(bool) {}
+void clear_player_tints() {}
+void set_player_tint(int, float, float, float, float) {}
+}
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+constexpr uint16_t kX = 0x0400, kY = 0x0800, kZ = 0x0010, kA = 0x0100, kB = 0x0200, kL = 0x0040, kR = 0x0020;
+constexpr int kWait = 14, kRun = 21, kAttack = 44, kGuard = 0xB3, kCatch = 0xD4, kShineLoop = 361;
+constexpr int kFox = 0x01 + 1, kFalco = 0x16 + 1, kMarth = 0x12 + 1;
+
+int range_violations = 0;
+struct In { uint16_t b = 0; int sx = 0, sy = 0, cx = 0, cy = 0; uint8_t tl = 0; };
+// One retrace on controller 4 (index 3); returns what the game gets.
+static host::PadState pad4(In in) {
+  host::PadState pads[4]{};
+  for (auto& q : pads) q.err = -1;
+  host::PadState& p = pads[3];
+  p.err = 0; p.button = in.b; p.stick_x = (int8_t)in.sx; p.stick_y = (int8_t)in.sy;
+  p.sub_x = (int8_t)in.cx; p.sub_y = (int8_t)in.cy; p.trig_l = in.tl;
+  // A real controller: a click comes with a full press.
+  if (in.b & 0x0040) p.trig_l = 230;
+  if (in.b & 0x0020) p.trig_r = 230;
+  ++tick; pad_mods::apply(pads);
+  // Every pad sent must be one a controller can produce: sticks inside their circle (the player's
+  // own values aside, which this test keeps inside it), a trigger click only with a full press.
+  if (p.stick_x * p.stick_x + p.stick_y * p.stick_y > 80 * 80) ++range_violations;
+  if (p.sub_x * p.sub_x + p.sub_y * p.sub_y > 80 * 80) ++range_violations;
+  if ((p.button & 0x0040) && p.trig_l < 200) ++range_violations;
+  if ((p.button & 0x0020) && p.trig_r < 200) ++range_violations;
+  return p;
+}
+static void fighter(int port, int kind, int motion, int air) {
+  std::memset(&view, 0, sizeof view);
+  view.port[port].present = 1; view.port[port].slot = local_slot; view.fighter_kind[port] = kind;
+  view.port[port].motion_id = motion; view.port[port].ground_or_air = (uint32_t)air;
+}
+static void state(int port, int motion, int air) { view.port[port].motion_id = motion; view.port[port].ground_or_air = (uint32_t)air; }
+static void only(int mod) { for (int m = 0; m < pad_mods::kCount; ++m) pad_mods::set_enabled(m, m == mod); }
+static void idle(int n = 12) { for (int i = 0; i < n; ++i) pad4({}); }   // long enough for a jump to age out
+
+int main() {
+  lcancel::set_native_view(native_view);
+  fighter(3, kFox, kRun, 0);
+  // Off by default.
+  CHECK(pad_mods::enabled(pad_mods::SlideStretch));   // the slide stretch starts on (it only acts after a backward slide)
+  pad_mods::set_enabled(pad_mods::SlideStretch, false);
+  CHECK(!pad_mods::any_enabled());
+  { host::PadState p = pad4({0, 0, 0, 0, 80}); CHECK(p.button == 0 && p.sub_y == 80); } idle();
+
+  // ---- C-stick up: X with the C-stick held back, then the C-stick on the next frame ----
+  for (int mode : {-1, 2, 3}) {        // offline, Direct, Teams: the same frames whatever the delay
+    network_mode = mode;
+    only(pad_mods::CStickUpJump); fighter(3, kFox, kRun, 0); idle();
+    host::PadState p = pad4({0, 0, 0, 0, 80});
+    CHECK(p.button == kX && p.sub_y == 0);
+    p = pad4({0, 0, 0, 0, 80});           // the state is not consulted: still running, C-stick goes
+    CHECK(p.button == kX && p.sub_y == 80);
+    p = pad4({0, 0, 0, 0, 80});           // held: X held with it, like a finger, no repeat
+    CHECK(p.button == kX && p.sub_y == 80);
+    p = pad4({});                          // let go: both up
+    CHECK(p.button == 0 && p.sub_y == 0);
+    idle();
+  }
+  network_mode = -1;
+  // A quick flick (released on frame 1) still sends the C-stick it pushed.
+  pad4({0, 0, 0, 0, 80});
+  CHECK(pad4({}).sub_y == 80);
+  CHECK(pad4({}).button == 0); idle();
+  // A second PADRead in the same retrace gets the same answer.
+  {
+    host::PadState p = pad4({0, 0, 0, 0, 80});
+    host::PadState again[4]{}; for (auto& q : again) q.err = -1; again[3].err = 0; again[3].sub_y = 80;
+    pad_mods::apply(again);
+    CHECK(again[3].button == p.button && again[3].sub_y == 0);
+    idle();
+  }
+  // Airborne, small or downward C-stick: untouched.
+  state(3, kWait, 1); CHECK(pad4({0, 0, 0, 0, 80}).button == 0); idle(); state(3, kWait, 0);
+  CHECK(pad4({0, 0, 0, 0, 40}).button == 0); idle();
+  CHECK(pad4({0, 0, 0, 0, -80}).button == 0); idle();
+  // No fighter on this controller: untouched.
+  std::memset(&view, 0, sizeof view);
+  CHECK(pad4({0, 0, 0, 0, 80}).button == 0); idle();
+
+  // ---- Fox/Falco B = shine: their one B, with the stick at 0.60 down, held back until it is taken ----
+  only(pad_mods::FoxFalcoShine);
+  for (int kind : {kFox, kFalco}) {
+    fighter(3, kind, kWait, 0); idle();                   // standing: down-B at once
+    host::PadState p = pad4({kB, 70, 0});
+    CHECK(p.button == kB && p.stick_x == 0 && p.stick_y == -48);   // past 0.55, short of the 0.66 drop line
+    p = pad4({0, 70, 0}); CHECK(p.button == kB && p.stick_x == 0 && p.stick_y == -48);   // a 2-frame press
+    state(3, 360, 0);
+    // Like a thumb: down 3 frames in all, then back to theirs through 2 in-between positions.
+    p = pad4({0, 70, 0}); CHECK(p.button == 0 && p.stick_x == 0 && p.stick_y == -48);
+    p = pad4({0, 70, 0}); CHECK(p.stick_x == 23 && p.stick_y == -32);
+    p = pad4({0, 70, 0}); CHECK(p.stick_x == 46 && p.stick_y == -16);
+    p = pad4({0, 70, 0}); CHECK(p.stick_x == 70 && p.stick_y == 0);
+    idle();
+    // B held longer: the stick stays down while it is, up to 6 frames.
+    fighter(3, kind, kWait, 0); idle();
+    for (int f = 0; f < 6; ++f) { p = pad4({kB, 70, 0}); CHECK(p.stick_y == -48); }
+    p = pad4({kB, 70, 0}); CHECK(p.stick_y > -48);           // after 6 frames: on its way back
+    state(3, 360, 0); idle();
+  }
+  // Early (an attack's end, a dash, a brake, landing lag): B is kept back, then goes in ONCE when the
+  // state takes down-B. Never pressed twice.
+  for (int lag : {kAttack, 20, 23, 42}) {
+    fighter(3, kFox, lag, 0); idle();
+    int presses = 0, first = -1;
+    bool was = false;
+    for (int f = 0; f < 16; ++f) {
+      if (f == 6) { if (lag == 42) view.port[3].anim_frame = 4.0f; else state(3, kWait, 0); }
+      host::PadState p = pad4({(uint16_t)(f < 2 ? kB : 0), 70, 0});   // a quick tap
+      const bool down = (p.button & kB) != 0;
+      if (down && !was) { ++presses; first = f; CHECK(p.stick_x == 0 && p.stick_y == -48); }
+      if (f == 0) CHECK(p.stick_x == 35 && p.stick_y == -24);   // on its way down
+      if (f >= 1 && f <= 8) CHECK(p.stick_x == 0 && p.stick_y == -48);   // down, waiting, pressed, held
+      if (f >= 12) CHECK(p.stick_x == 70 && p.stick_y == 0);    // back, gradually
+      was = down;
+    }
+    CHECK(presses == 1 && first == 6);
+    view.port[3].anim_frame = 0.0f;
+    idle();
+  }
+  // Never able to act: dropped after the window; never a late neutral-B.
+  fighter(3, kFox, 20, 0); idle();
+  for (int f = 0; f < 40; ++f) CHECK(!(pad4({(uint16_t)(f < 3 ? kB : 0)}).button & kB));
+  idle();
+  // Another button while it waits: B dropped, their button goes through.
+  fighter(3, kFox, kAttack, 0); idle();
+  CHECK(pad4({kB}).button == 0); pad4({});
+  CHECK(pad4({kA}).button == kA); state(3, kWait, 0);
+  for (int f = 0; f < 10; ++f) CHECK(pad4({}).button == 0);
+  idle();
+  // Mashing B while running: each fresh press is one down + B.
+  fighter(3, kFox, kRun, 0); idle();
+  for (int i = 0; i < 20; ++i) {
+    host::PadState p = pad4({(uint16_t)(i % 4 < 2 ? kB : 0), 70, 0});
+    if (i % 4 == 0) CHECK(p.button == kB && p.stick_y == -48);
+    if (i % 4 >= 2) CHECK(!(p.button & kB));
+  }
+  idle();
+  // Jumpsquat: left alone.
+  fighter(3, kFox, 24, 0); idle();
+  CHECK(pad4({kB, 0, 0}).stick_y == 0); idle(30);
+  // A quick B right after a jump (the state still says grounded): the laser, untouched.
+  for (int delay : {0, 2}) {
+    network_mode = delay ? 2 : -1; online_delay = delay;
+    fighter(3, kFox, 15, 0); idle(12);   // walking (standing still keeps the laser)
+    pad4({kX}); pad4({});
+    host::PadState p = pad4({kB, 0, 0});
+    CHECK(p.button == kB && p.stick_y == 0);
+    idle(12);
+    // Tap jump too.
+    pad4({0, 0, 70}); pad4({0, 0, 70});
+    p = pad4({kB, 0, 70});
+    CHECK(p.stick_y == 70);
+    idle(12);
+    // Long after the jump (landed): a shine again.
+    CHECK(pad4({kB, 0, 0}).stick_y == -48);
+    idle(12);
+  }
+  network_mode = -1;
+  // Standing still, stick in the middle: the laser stays; a tilt in Wait is still a shine.
+  fighter(3, kFox, kWait, 0); idle(12);
+  { host::PadState p = pad4({kB, 0, 0}); CHECK(p.button == kB && p.stick_y == 0); }
+  for (int f = 0; f < 4; ++f) { host::PadState p = pad4({kB, 0, 0}); CHECK(p.stick_y == 0); }
+  idle(12);
+  CHECK(pad4({kB, 40, 0}).stick_y == -48); idle(12);
+  fighter(3, kFox, kRun, 1); CHECK(pad4({kB, 0, 60}).stick_y == 60); idle();
+  fighter(3, kMarth, kRun, 0); CHECK(pad4({kB, 0, 60}).stick_y == 60); idle();
+  fighter(3, 0, kRun, 0); CHECK(pad4({kB, 0, 60}).stick_y == 60); idle();   // older game library
+
+  // ---- Z always grabs: waits delay + 1 frames to see each press ----
+  only(pad_mods::ZAlwaysGrabs);
+  for (int delay : {0, 2}) {
+    network_mode = delay ? 2 : -1; online_delay = delay;
+    // Actionable: the press passes; once the grab shows, nothing more.
+    fighter(3, kFox, kWait, 0); idle();
+    CHECK(pad4({kZ}).button == kZ);
+    for (int i = 0; i < delay; ++i) { host::PadState p = pad4({kZ}); CHECK(!(p.button & kZ) && p.trig_l > 0); }
+    state(3, kCatch, 0);
+    for (int i = 0; i < 6; ++i) { host::PadState p = pad4({kZ}); CHECK(p.button == kZ && p.trig_l == 0); }
+    idle(); state(3, kWait, 0); idle();
+    // Pressed in landing lag: shield held for delay + 1 frames, then Z again, until a grab shows.
+    state(3, 42, 0);
+    CHECK(pad4({kZ}).button == kZ);
+    for (int i = 0; i < delay + 1; ++i) { host::PadState p = pad4({kZ}); CHECK(!(p.button & (kZ | kA)) && p.trig_l > 0); }
+    state(3, kGuard, 0);
+    CHECK(pad4({kZ}).button & kZ);                         // fresh A with the shield held
+    state(3, kCatch, 0);
+    CHECK(pad4({kZ}).button == kZ);                        // grab seen: hands off
+    idle(); state(3, kWait, 0); idle(8);
+    // Never grabbing: gives up after the tries.
+    state(3, 42, 0);
+    pad4({kZ});
+    host::PadState p{};
+    for (int i = 0; i < 40; ++i) p = pad4({});
+    CHECK(p.button == 0 && p.trig_l == 0);
+    idle(); state(3, kWait, 0);
+  }
+  network_mode = -1;
+
+  // ---- Shine wavedash: wait for the Loop, one X (2 frames), their own R on frame J ----
+  only(pad_mods::ShineWavedash);
+  for (int mode : {-1, 2}) {
+    network_mode = mode;
+    for (int kind : {kFox, kFalco}) {
+      const int j = kind == kFox ? 3 : 5;
+      fighter(3, kind, 360, 0); idle();                   // shine Start: no jump yet
+      for (int i = 0; i < 3; ++i) {
+        host::PadState p = pad4({kR, 60, 0});
+        CHECK(!(p.button & (kR | kL | kX)) && p.trig_l == 0);
+      }
+      state(3, kShineLoop, 0);
+      const int d = mode >= 0 ? online_delay : 0;
+      for (int f = 0; f <= j + 3; ++f) {
+        if (f == d + 1) state(3, 24, 0);                   // the X shows: jumpsquat
+        if (f == j + d + 1) state(3, 25, 1);               // airborne
+        host::PadState p = pad4({kR, 60, 0});             // R held, stick flat right
+        if (f < j) {
+          CHECK(((p.button & kX) != 0) == (f < 2));
+          CHECK(!(p.button & (kR | kL)));
+        } else {
+          CHECK((p.button & kR) && !(p.button & kL) && !(p.button & kX));   // their R, no L
+          if (f < j + 2) CHECK(p.stick_x == 76 && p.stick_y == -24);       // max length, on the circle
+          else CHECK(p.stick_x == 60 && p.stick_y == 0);
+        }
+      }
+      CHECK(pad4({}).button == 0);                         // let go: done
+      idle();
+    }
+  }
+  network_mode = -1;
+  // Their own jump first (TSC 11-08: Y, then R a frame or few later): the dodge goes on the first
+  // airborne frame counted from THEIR jump press, the mod presses no jump of its own.
+  for (int mode : {-1, 2}) {
+    network_mode = mode;
+    const int d = mode >= 0 ? online_delay : 0;
+    for (int kind : {kFox, kFalco}) {
+      const int j = kind == kFox ? 3 : 5;
+      for (int rgap = 0; rgap <= j; ++rgap) {           // R this many frames after their Y
+        fighter(3, kind, kWait, 0); idle(45);              // past the waveland lag buffer
+        state(3, kShineLoop, 0);
+        for (int f = 0; f <= j + 3; ++f) {
+          if (f == d + 1) state(3, 24, 0);                 // their Y shows: jumpsquat
+          if (f == j + d + 1) state(3, 25, 1);
+          In in{(uint16_t)(f < 3 ? kY : 0), 60, 0};       // Y held 3 frames, stick flat right
+          if (f >= rgap) in.b |= kR;
+          host::PadState p = pad4(in);
+          CHECK(!(p.button & kX));                          // no jump of the mod's
+          CHECK(((p.button & kY) != 0) == (f < 3));
+          if (rgap == j) { CHECK(((p.button & kR) != 0) == (f >= j)); continue; }   // on time: theirs as is
+          if (f < j) CHECK(!(p.button & (kR | kL)));
+          else {
+            CHECK((p.button & kR) && !(p.button & kL));
+            if (f < j + 2) CHECK(p.stick_x == 76 && p.stick_y == -24);
+          }
+        }
+        CHECK(pad4({}).button == 0);
+        idle();
+      }
+      // R first, their Y while the mod still waits for the Loop: counted from their Y.
+      fighter(3, kind, kWait, 0); idle(45);
+      state(3, 360, 0);
+      pad4({kR, 60, 0}); pad4({kR, 60, 0});
