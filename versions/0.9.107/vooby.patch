+  CHECK(pad4({}).button == 0);
+  state(3, kWait, 0);
+  CHECK(pad4({kR, 0, 0}).button & kR);                  // a new press shields again
+  CHECK(pad4({}).button == 0); idle(45);
+  // Jump first, then R: the wavedash on their jump, as with the switch off.
+  fighter(3, kFox, kWait, 0); idle(45);
+  for (int f = 0; f <= 4; ++f) {
+    if (f == 1) state(3, 24, 0);
+    if (f == 4) state(3, 25, 1);
+    In in{(uint16_t)(f < 3 ? kY : 0), 60, 0};
+    if (f >= 1) in.b |= kR;
+    host::PadState p = pad4(in);
+    if (f < 3) CHECK(!(p.button & kR)); else CHECK(p.button & kR);
+  }
+  CHECK(pad4({}).button == 0); idle(45);
+  pad_mods::set_sub_option(pad_mods::GroundWavedash, false);
+  // Their jump that never came out (pressed in a state the view had wrong): R is theirs again.
+  fighter(3, kFox, kWait, 0); idle(45);
+  pad4({kY, 60, 0}); state(3, 43, 0);
+  pad4({(uint16_t)(kY | kR), 60, 0});
+  { host::PadState p = pad4({(uint16_t)(kY | kR), 60, 0}); CHECK(p.button & kR); }
+  idle(45);
+  fighter(3, kFox, 246, 0); idle();                       // teetering
+  CHECK(pad4({kR, -80, 0}).button & kX);
+  idle(); state(3, kWait, 0);
+
+  // ---- Sliding backward after a wavedash/waveland: a backward tilt becomes the slow forward walk ----
+  only(pad_mods::SlideStretch);   // on its own: the one-button wavedash off
+  fighter(3, 0x19 + 1, 236, 1); view.facing[3] = 1.0f; idle(30);
+  pad4({});
+  state(3, 43, 0); view.vel_x[3] = -2.0f;                         // landed, sliding backward
+  for (int f = 0; f < 3; ++f) pad4({0, 0, 0});
+  { host::PadState p = pad4({0, 0, 0}); CHECK(p.stick_x == 0); }   // neutral: theirs
+  state(3, kWait, 0);
+  { host::PadState p = pad4({0, -76, -24}); CHECK(p.stick_x == -76); }   // their air dodge angle held: theirs
+  { host::PadState p = pad4({0, -80, 0}); CHECK(p.stick_x == -80); }     // a full push back: theirs
+  pad4({0, -40, 0});                                                // a gentle tilt back: halfway in
+  { host::PadState p = pad4({0, -40, 0}); CHECK(p.stick_x == 23 && p.stick_y == 0); }   // the walk
+  { host::PadState p = pad4({0, 50, 0}); CHECK(p.stick_x != 23); } // forward: theirs (halfway out)
+  { host::PadState p = pad4({0, 50, 0}); CHECK(p.stick_x == 50); }
+  view.vel_x[3] = 0.0f;                                             // stopped: back is theirs (a turn)
+  { host::PadState p = pad4({0, -40, 0}); CHECK(p.stick_x == -40); }
+  idle(30); view.facing[3] = 0.0f;
+  // R held through a backward waveland: the walk; the stick moved somewhere new: theirs.
+  fighter(3, 0x19 + 1, 236, 1); view.facing[3] = 1.0f; idle(30);
+  pad4({kR, -60, -40});
+  state(3, 43, 0); view.vel_x[3] = -2.0f;
+  for (int f = 0; f < 3; ++f) pad4({kR, -60, -40});
+  { host::PadState p = pad4({kR, -60, -40}); CHECK(p.stick_x == 23 && p.stick_y == 0); }
+  for (int f = 0; f < 4; ++f) { host::PadState p = pad4({kR, 0, 0}); CHECK(p.stick_x == 23); }   // let go of the stick: still walking
+  for (int f = 0; f < 4; ++f) { host::PadState p = pad4({kR, -80, 0}); CHECK(p.stick_x == 23 && p.stick_y == 0); }   // held full back: still
+  for (int f = 0; f < 4; ++f) { host::PadState p = pad4({kR, -56, -56}); CHECK(p.stick_x == 23 && p.stick_y == 0); } // down-back: still
+  for (int f = 0; f < 2; ++f) { host::PadState p = pad4({kR, 0, -80}); CHECK(p.stick_x == 23 && p.stick_y == 0); }   // down: still
+  { host::PadState p = pad4({kR, 70, 0}); CHECK(p.stick_x == 70); }
+  { host::PadState p = pad4({kR, 70, 0}); CHECK(p.stick_x == 70); }
+  view.vel_x[3] = 0.0f; idle(30); view.facing[3] = 0.0f; state(3, kWait, 0);
+  // Marth and Roy the same: fast fall, down-back dodge, the stick kept back with R held
+  for (int32_t k : {0x12 + 1, 0x1A + 1}) {
+    fighter(3, k, 236, 1); view.facing[3] = -1.0f; idle(30);
+    pad4({kR, 56, -56});
+    state(3, 43, 0); view.vel_x[3] = 2.0f;                          // facing left, sliding right = backward
+    for (int f = 0; f < 3; ++f) pad4({kR, 56, -56});
+    for (int f = 0; f < 6; ++f) { host::PadState p = pad4({kR, 80, -20}); CHECK(p.stick_x == -23 && p.stick_y == 0); }
+    { host::PadState p = pad4({kR, -70, 0}); CHECK(p.stick_x == -70); }   // forward: theirs
+    view.vel_x[3] = 0.0f; idle(30); view.facing[3] = 0.0f; state(3, kWait, 0);
+  }
+  // A forward slide (ledgedash) with R still held: the stick is theirs, so down + B is a down-B.
+  fighter(3, 0x19 + 1, 236, 1); view.facing[3] = 1.0f; idle(30);
+  pad4({kR, 76, -24});
+  state(3, 43, 0); view.vel_x[3] = 2.0f;
+  for (int f = 0; f < 4; ++f) { host::PadState p = pad4({kR, 0, -80}); CHECK(p.stick_x == 0 && p.stick_y == -80); }
+  view.vel_x[3] = 0.0f; idle(30); view.facing[3] = 0.0f; state(3, kWait, 0);
+  // Walking a backward slide with R held: a B press takes their stick at once (no halfway frame).
+  fighter(3, 0x19 + 1, 236, 1); view.facing[3] = 1.0f; idle(30);
+  pad4({kR, -60, -40});
+  state(3, 43, 0); view.vel_x[3] = -2.0f;
+  for (int f = 0; f < 5; ++f) pad4({kR, -60, -40});
+  { host::PadState p = pad4({kR, -60, -40}); CHECK(p.stick_x == 23); }
+  { host::PadState p = pad4({(uint16_t)(kR | kB), 0, -80}); CHECK(p.stick_x == 0 && p.stick_y == -80); }
+  view.vel_x[3] = 0.0f; idle(30); view.facing[3] = 0.0f; state(3, kWait, 0);
+  // A new R wavedash out of a backward slide (R held = the walk): the dodge keeps its own angle.
+  only(pad_mods::SlideStretch); pad_mods::set_enabled(pad_mods::GroundWavedash, true);
+  fighter(3, 0x19 + 1, 236, 1); view.facing[3] = 1.0f; idle(30);
+  pad4({kR, -60, -40});
+  state(3, 43, 0); view.vel_x[3] = -2.0f;
+  for (int f = 0; f < 4; ++f) pad4({kR, -60, -40});
+  for (int f = 0; f < 6; ++f) pad4({kR, -60, -40});   // the walk
+  state(3, 18, 0); pad4({0, -62, -50}); pad4({0, -62, -50});   // let go of R, then a fresh R with their angle
+  {
+    int dodge = -1, sx = 0, sy = 0;
+    for (int f = 0; f < 10 && dodge < 0; ++f) {
+      if (f == 1) state(3, 24, 0);
+      host::PadState p = pad4({kR, -62, -50});
+      if ((p.button & kR) || p.trig_r > 100) { dodge = f; sx = p.stick_x; sy = p.stick_y; }
+    }
+    CHECK(dodge > 0 && sx == -62 && sy == -50);
+  }
+  view.vel_x[3] = 0.0f; idle(30); view.facing[3] = 0.0f; state(3, kWait, 0);
+  // Not a fighter it helps: no walk.
+  fighter(3, kFox, kWait, 0); view.facing[3] = 1.0f; idle(30);
+  for (int f = 0; f < 14; ++f) { if (f == 1) state(3, 24, 0); if (f == 4) { state(3, 43, 0); view.vel_x[3] = -2.0f; }
+    host::PadState p = pad4({kR, -80, 0}); if (f >= 8) CHECK(p.stick_x != 23); }
+  view.vel_x[3] = 0.0f; idle(30); view.facing[3] = 0.0f; state(3, kWait, 0);
+
+  // ---- Sheik reported as Zelda (transformed): after a 3-frame jumpsquat is seen, Sheik's timing ----
+  only(pad_mods::GroundWavedash);
+  fighter(3, 0x13 + 1, kWait, 0); idle(30);
+  state(3, 24, 0); pad4({}); pad4({}); pad4({}); state(3, 25, 1); pad4({}); state(3, kWait, 0); idle();   // a 3-frame jumpsquat
+  for (int f = 0; f <= 4; ++f) {
+    if (f == 1) state(3, 24, 0);
+    host::PadState p = pad4({kR, 80, 0});
+    if (f == 3) CHECK((p.button & kR) && p.stick_x == 76);   // the dodge on Sheik's frame 3, not Zelda's 6
+  }
+  idle(30); state(3, kWait, 0);
+
+  // ---- The master switch: off, nothing happens; on again, the same mods are back ----
+  only(pad_mods::CStickUpJump); pad_mods::set_all_enabled(false);
+  fighter(3, kFox, kRun, 0); idle();
+  CHECK(pad4({0, 0, 0, 0, 80}).button == 0); idle();
+  pad_mods::set_all_enabled(true);
+  CHECK(pad4({0, 0, 0, 0, 80}).button == kX); idle();
+
+  // ---- C-stick up in a waveland's landing lag with R held: waits, then the up-smash; never a shield ----
+  only(pad_mods::CStickUpJump); pad_mods::set_enabled(pad_mods::GroundWavedash, true);
+  fighter(3, 0x19 + 1, 236, 1); idle(30);
+  pad4({kR, -60, -40});                                  // their air dodge
+  state(3, 43, 0);
+  for (int f = 0; f < 4; ++f) { host::PadState p = pad4({kR, 0, 0, 0, 80}); CHECK(p.sub_y == 0 && !(p.button & (kX | kR)) && p.trig_r == 0); }
+  state(3, kWait, 0);
+  { host::PadState p = pad4({kR, 0, 0, 0, 80}); CHECK((p.button & kX) && !(p.button & kR) && p.trig_r == 0 && p.sub_y == 0); }
+  { host::PadState p = pad4({kR, 0, 0, 0, 80}); CHECK((p.button & kX) && p.sub_y == 80 && !(p.button & kR) && p.trig_r == 0); }
+  idle(30); state(3, kWait, 0);
+  // a quick flick let go before the lag ends still comes out when it does
+  fighter(3, 0x19 + 1, 236, 1); idle(30);
+  pad4({kR, -60, -40});
+  state(3, 43, 0);
+  for (int f = 0; f < 2; ++f) { host::PadState p = pad4({kR, 0, 0, 0, 80}); CHECK(p.sub_y == 0 && !(p.button & kR)); }
+  for (int f = 0; f < 4; ++f) { host::PadState p = pad4({kR}); CHECK(!(p.button & (kX | kR)) && p.trig_r == 0); }
+  state(3, kWait, 0);
+  { host::PadState p = pad4({kR}); CHECK((p.button & kX) && !(p.button & kR) && p.sub_y == 0); }
+  { host::PadState p = pad4({kR}); CHECK((p.button & kX) && p.sub_y == 80 && !(p.button & kR)); }
+  idle(30); state(3, kWait, 0);
+
+  // ---- Jump with Y: the same moves, Y instead of X ----
+  only(pad_mods::GroundWavedash); pad_mods::set_enabled(pad_mods::JumpWithY, true);
+  fighter(3, kFox, kWait, 0); idle();
+  { host::PadState p = pad4({kR}); CHECK((p.button & kY) && !(p.button & kX)); }
+  idle();
+  only(pad_mods::CStickUpJump); pad_mods::set_enabled(pad_mods::JumpWithY, true);
+  fighter(3, kFox, kRun, 0); idle();
+  CHECK(pad4({0, 0, 0, 0, 80}).button == kY); idle();
+  pad_mods::set_enabled(pad_mods::JumpWithY, false);
+
+  // ---- Our Auto L-cancel: its own switch, also in Teams; the game's setting stays as shipped ----
+  CHECK(!lcancel::policy::automatic_allowed(3, true));
+  only(pad_mods::AutoLCancel);
+  CHECK(lcancel::mod_automatic_enabled());
+  CHECK(lcancel::policy::mod_automatic_allowed(3, lcancel::mod_automatic_enabled()));
+  only(pad_mods::CStickUpJump);
+  CHECK(!lcancel::mod_automatic_enabled());
+
+  CHECK(range_violations == 0);
+  std::puts("pad_mods: ok");
+  return 0;
+}
