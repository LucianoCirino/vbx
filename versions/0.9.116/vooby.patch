+// The block list (port/runtime/hle/slippi_net.cpp, Matchmaking::FindMatch): connect codes in
+// blocked-codes.txt beside the game, one per line, turned down in Unranked AND Teams searches (the
+// game's own skip list counts in Teams too). Read at every search, so edits count from the next one.
+constexpr int kBlockTab = pad_mods::kGroupCount;
+inline std::vector<std::string> read_blocked() {
+  std::vector<std::string> out;
+  std::ifstream f("blocked-codes.txt");
+  std::string line;
+  while (std::getline(f, line)) {
+    line = line.substr(0, line.find(';'));
+    const auto a = line.find_first_not_of(" \t\r"), b = line.find_last_not_of(" \t\r");
+    if (a != std::string::npos) out.push_back(line.substr(a, b - a + 1));
+  }
+  return out;
+}
+inline void write_blocked(const std::vector<std::string>& codes) {
+  std::ofstream f("blocked-codes.txt", std::ios::trunc);
+  f << "; Connect codes turned down in Unranked and Teams matchmaking (Vooby Mods). One per line.\n";
+  for (const auto& c : codes) f << c << "\n";
+}
+// The people met online (slippi_net.cpp writes recent-players.txt when a match is found): time,
+// code, name, mode per line, newest last. Newest first here, once per code.
+struct Met { long long when = 0; std::string code, name, mode; };
+inline std::vector<Met> read_recent() {
+  std::vector<Met> all, out;
+  std::ifstream f("recent-players.txt");
+  for (std::string l; std::getline(f, l);) {
+    Met m; size_t p0 = 0;
+    std::string part[4];
+    for (int i = 0; i < 4; ++i) {
+      const size_t p1 = i < 3 ? l.find('\t', p0) : std::string::npos;
+      part[i] = l.substr(p0, p1 == std::string::npos ? std::string::npos : p1 - p0);
+      if (p1 == std::string::npos) break;
+      p0 = p1 + 1;
+    }
+    if (part[1].empty()) continue;
+    m.when = std::atoll(part[0].c_str()); m.code = part[1]; m.name = part[2]; m.mode = part[3];
+    all.push_back(m);
+  }
+  for (auto it = all.rbegin(); it != all.rend() && out.size() < 30; ++it) {
+    bool seen = false;
+    for (const auto& o : out) seen |= o.code == it->code;
+    if (!seen) out.push_back(*it);
+  }
+  return out;
+}
+inline std::string clean_code(const char* in) {
+  std::string c;
+  for (const char* p = in; *p; ++p) if (!std::isspace((unsigned char)*p)) c += (char)std::toupper((unsigned char)*p);
+  return c;
+}
+inline std::string ago(long long when) {
+  const long long d = (long long)std::time(nullptr) - when;
+  char b[32];
+  if (d < 60) return "just now";
+  if (d < 3600) std::snprintf(b, sizeof b, "%lld min ago", d / 60);
+  else if (d < 86400) std::snprintf(b, sizeof b, "%lld h ago", d / 3600);
+  else std::snprintf(b, sizeof b, "%lld d ago", d / 86400);
+  return b;
+}
