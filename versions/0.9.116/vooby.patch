+  int lz_frame = -1, lz_hops = 0;
+  int lz_face = 1;           // facing when the loop started: the lasers keep going that way
+  int lz_back_frames = 0;    // frames the backward stick has been held off (the first is halfway)
+  // The game's "last sideways flick" memory, followed from the sticks sent (Fighter_procInput:
+  // crossing out past horizontal_stick_smash_deadzone 0.25 sets x2228_b7 and zeroes
+  // active_duration.lstick.x): direction (+1 right, -1 left, 0 none) and frames since.
+  int flick_dir = 0, flick_age = 255;
+  bool lz_nudge = false;
+  int lz_since_arm = 0, lz_since_ground = -1;   // for the log: how long the first hop took
+  // in the air (the first laser, or falling off a platform): B for a refire (frames left), a new
+  // laser's sequence (-1 off), whether it starts with the forward roll; the view last frame
+  int lz_refire = 0, lz_newl = -1;
+  int lz_jsb = -1;   // a B pressed in the jumpsquat: frames it has been held back (-1 off)
+  bool lz_newl_nudge = false;
+  int32_t lz_prev_m = -1;
+  float lz_prev_a = 0.0f;
+  float flick_prev_x = 0.0f;
