+  bool cs_used = false;          // this shine already had its up-smash
+  int8_t held_x = 0, held_y = 0;
+  // Z in a shine (JC grab): next frame (-1 off, kGrabWaiting before the shine's Loop)
+  int grab_frame = -1, grab_waited = 0, grab_retries = 0, grab_face = 0;   // grab_face: side to turn to first
+  // shine: frames since the B (-1 off)
+  int shine_frame = -1, shine_wait = -1, shine_ret = -1;   // shine_ret: frames of the stick's way back   // B sent: frames since; B held back: frames waited
+  uint16_t buttons_was_down = 0;
+  int jumpsquat = kJumpsquatFox, x_hold = 2, late = 0;   // wavedash
+  // frames since the last jump press (X, Y, a tap jump, or one the mods sent)
+  int jump_age = 1000;
+  bool jump_mod = false;   // the last jump was one the mods pressed
