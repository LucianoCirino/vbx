+  else
+  {
+    for (int m : kOrder)
+      if (pad_mods::info(m).group == tab) changed |= card(m);
+    for (int m = 0; m < pad_mods::kCount; ++m) {   // any mod the order above does not name yet still shows
+      bool listed = false;
+      for (int k : kOrder) listed |= k == m;
+      if (!listed && pad_mods::info(m).group == tab) changed |= card(m);
+    }
+  }
+  ImGui::EndDisabled();
+  ImGui::EndChild();
+  ImGui::PopStyleVar();
+  ImGui::PopStyleColor();
+
+  // ---- footer
+  const float fy = wp.y + ws.y - foot;
+  d->AddLine(ImVec2(wp.x + sw, fy), ImVec2(wp.x + ws.x, fy), kEdge, 1.0f);
+  d->AddText(ImVec2(wp.x + sw + 22 * s, fy + 18 * s), kMuted, "Offline, Direct and Teams. Never Ranked, Unranked or Party.");
+  {
+    const char* t = "Close";
+    const ImVec2 ts = ImGui::CalcTextSize(t);
+    const float bw = ts.x + 40 * s, bh = 34 * s;
+    ImGui::SetCursorScreenPos(ImVec2(wp.x + ws.x - bw - 20 * s, fy + (foot - bh) * 0.5f));
+    const bool click = ImGui::InvisibleButton("##close", ImVec2(bw, bh));
+    const bool hot = ImGui::IsItemHovered() || ImGui::IsItemFocused();
+    const ImVec2 a = ImGui::GetItemRectMin(), b = ImGui::GetItemRectMax();
+    grad(d, a, b, hot ? kPink : mix(kPink, IM_COL32(0, 0, 0, 255), 0.3f), hot ? kViolet : mix(kViolet, IM_COL32(0, 0, 0, 255), 0.3f), bh * 0.5f);
+    d->AddText(ImVec2(a.x + (bw - ts.x) * 0.5f, a.y + (bh - ts.y) * 0.5f), kInk, t);
+    if (click || ImGui::IsKeyPressed(ImGuiKey_Escape) || ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight)) {
+      *open = false;
+      ImGui::CloseCurrentPopup();
+    }
+  }
+  ImGui::EndPopup();
+  return changed;
+}
+
+}  // namespace vooby_ui
