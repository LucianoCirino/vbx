+// ---- AI takeover ----
+std::atomic<int> g_ai_choice[kAiKinds] = {};
+const bool g_ai_choice_defaults = [] { for (auto& c : g_ai_choice) c.store(kAiDefault); return true; }();
+std::atomic<bool> g_ai_on[4] = {};
+bool g_ai_dd_was[4] = {};
+uint16_t g_ai_lr_was[4] = {};
+std::atomic<int> g_ai_step[4] = {};   // D-pad left/right while the AI plays (take_ai_target_step)
+uint32_t g_ai_retrace = 0xFFFFFFFFu;
+constexpr uint16_t kPadDDown = 0x0004, kPadDLeft = 0x0001, kPadDRight = 0x0002;
+int take_ai_target_step(int port) { return port >= 0 && port < 4 ? g_ai_step[port].exchange(0) : 0; }
+const char* ai_kind_name(int kind) {
+  static const char* const names[kAiKinds] = {
+      "Mario", "Fox", "Captain Falcon", "Donkey Kong", "Kirby", "Bowser", "Link", "Sheik", "Ness",
+      "Peach", "Ice Climbers", "", "Pikachu", "Samus", "Yoshi", "Jigglypuff", "Mewtwo", "Luigi",
+      "Marth", "Zelda", "Young Link", "Dr. Mario", "Falco", "Pichu", "Mr. Game & Watch", "Ganondorf", "Roy"};
+  return kind >= 0 && kind < kAiKinds ? names[kind] : "";
+}
+int ai_choice(int kind) { return kind >= 0 && kind < kAiKinds ? g_ai_choice[kind].load() : kAiDefault; }
+void set_ai_choice(int kind, int choice) { if (kind >= 0 && kind < kAiKinds) g_ai_choice[kind].store(choice); }
+bool ai_active(int port) { return port >= 0 && port < 4 && g_ai_on[port].load(std::memory_order_relaxed); }
+std::atomic<AiDriver> g_ai_driver{nullptr};
+void set_ai_driver(AiDriver driver) { g_ai_driver.store(driver); }
+host::PadState g_ai_pad[4];   // this retrace's AI controller, for a second read in the same retrace
+// D-pad down flips the AI for that controller. Only while a fighter of that port is in an offline
+// match; off everywhere else (and the flag clears, so the next match starts with you playing).
+void ai_poll(host::PadState pads[4]) {
+  const uint32_t retrace = host::retrace_count();
+  const bool repeat = retrace == g_ai_retrace;   // a second PADRead in one retrace: same answer
+  g_ai_retrace = retrace;
+  // The same modes as every Vooby Mod: offline, Direct and Teams (the AI only presses this
+  // controller's buttons, so it travels online like any input and cannot desync).
+  const bool online = slippi::online::session_mode() >= 0;
+  const bool ok = enabled(AiTakeover) && allowed_now() && all_enabled();
+  MuLcancelView view{};
+  if (ok && !repeat) lcancel::observe(&view);
+  for (int p = 0; p < 4; ++p) {
+    const bool dd = pads[p].err == 0 && (pads[p].button & kPadDDown);
+    if (!ok) { g_ai_on[p].store(false); g_ai_dd_was[p] = dd; continue; }
+    if (!repeat) {
+      // Online the view holds the one local fighter, filed wherever the library put it.
+      bool present = view.port[p].present != 0;
+      if (online) { present = false; for (const auto& f : view.port) present |= f.present != 0; present &= pads[p].err == 0; }
+      if (!present) g_ai_on[p].store(false);
+      else if (dd && !g_ai_dd_was[p]) {
+        g_ai_on[p].store(!g_ai_on[p].load());
+        host::log("padmods: AI takeover %s on controller %d (%s)", g_ai_on[p].load() ? "on" : "off", p + 1,
+                  online ? "online" : "offline");
+      }
+      g_ai_dd_was[p] = dd;
+      // D-pad left/right while it plays: the previous/next opponent as its target.
+      const uint16_t lr = pads[p].err == 0 ? (uint16_t)(pads[p].button & (kPadDLeft | kPadDRight)) : 0;
+      const uint16_t fresh = (uint16_t)(lr & ~g_ai_lr_was[p]);
+      if (g_ai_on[p].load() && fresh) g_ai_step[p].store((fresh & kPadDRight) ? 1 : -1);
+      g_ai_lr_was[p] = lr;
+    }
+    if (dd) pads[p].button &= (uint16_t)~kPadDDown;   // the switch, never the game's
+  }
+}
+
+void apply_mods(host::PadState pads[4]);
+// The pads as the game gets them: D-pad down for the takeover, the mods, then an AI's controller in
+// place of the pad of every port it plays for (after the mods: none of them touches the AI's presses).
+void apply(host::PadState pads[4]) {
+  const uint32_t retrace = host::retrace_count();
+  const bool repeat = retrace == g_ai_retrace;
+  ai_poll(pads);
+  host::PadState raw[4];
+  for (int p = 0; p < 4; ++p) raw[p] = pads[p];
+  apply_mods(pads);
+  const AiDriver drive = g_ai_driver.load();
+  for (int p = 0; p < 4; ++p) {
+    if (!ai_active(p) || !drive) continue;
+    if (repeat) { pads[p] = g_ai_pad[p]; continue; }
+    // The AI plays from the player's own controller: no mod acts for a port an AI plays, and the
+    // mods' moves in progress there are dropped (TSC 11-10).
+    g_ports[p] = PortState{};
+    host::PadState ai = raw[p];
+    if (drive(p, ai)) { pads[p] = ai; g_ai_pad[p] = ai; }
+    else g_ai_pad[p] = pads[p];
+  }
+  // START held, or L + R + A together (the pause's quit, which is held before START): the player's
+  // own controller, untouched by the mods or an AI (TSC 11-10: could not quit out of a pause).
+  constexpr uint16_t kQuit = kPadL | kPadR | kPadA;
+  for (int p = 0; p < 4; ++p)
+    if ((raw[p].button & kPadStart) || (raw[p].button & kQuit) == kQuit) pads[p] = raw[p];
+}
+
+void apply_mods(host::PadState pads[4]) {
+  if (!all_enabled() || !any_enabled() || !allowed_now()) { reset(); return; }
+
+  const uint32_t retrace = host::retrace_count();
+  if (retrace == g_last_retrace) {
+    // A second PADRead inside one retrace gets the same answer as the first.
+    for (int p = 0; p < 4; ++p) put(pads[p], g_ports[p].out);
+    return;
+  }
+  g_last_retrace = retrace;
+
+  MuLcancelView view;
+  lcancel::observe(&view);
+  const bool online = slippi::online::session_mode() >= 0;
+  const MuLcancelFighter* local = nullptr;   // online: the one local fighter, wherever it is filed
+  int32_t local_kind = 0;
+  float local_facing = 0.0f;
+  const uint8_t shield = shield_hold_value(view);
+  // Frames between reading a pad and the game using it: the online match's delay, or offline delay.
+  const int delay = online ? slippi::online::match_input_delay()
+                           : (gx::RenderOptions::live_offline_delay() ? gx::RenderOptions::live_offline_delay_frames() : 0);
+  if (online)
+    for (int i = 0; i < 4; ++i)
+      if (view.port[i].present) { local = &view.port[i]; local_kind = view.fighter_kind[i]; local_facing = view.facing[i]; break; }
+
+  for (int p = 0; p < 4; ++p) {
+    PortState& st = g_ports[p];
+    host::PadState& pad = pads[p];
+    const MuLcancelFighter* fighter = online ? (pad.err == 0 ? local : nullptr)
+                                             : (view.port[p].present ? &view.port[p] : nullptr);
+    int32_t kind = fighter ? (online ? local_kind : view.fighter_kind[p]) : 0;
+    // Zelda/Sheik: the player record keeps the select screen's character, not the one transformed
+    // into (TSC 11-06: Sheik reported as Zelda, wavedashes on Zelda's 6-frame jumpsquat). Tell them
+    // apart by the last jumpsquat watched: Sheik 3 frames, Zelda 6.
+    if (fighter) {
+      if (fighter->motion_id == kKneeBend && fighter->ground_or_air == 0) ++st.js_run;
+      else { if (st.js_run >= 2 && st.js_run <= 9) st.js_learned = st.js_run; st.js_run = 0; }
+      constexpr int32_t kKindSheik = 0x07 + 1, kKindZelda = 0x13 + 1;
+      if ((kind == kKindZelda || kind == kKindSheik) && st.js_learned)
+        kind = st.js_learned <= 4 ? kKindSheik : kKindZelda;
+    }
+    const float facing = fighter ? (online ? local_facing : view.facing[p]) : 0.0f;
+    float vel_x = 0.0f;
+    if (fighter) for (int i = 0; i < 4; ++i) if (&view.port[i] == fighter) { vel_x = view.vel_x[i]; st.px = view.pos_x[i]; st.py = view.pos_y[i]; }
+    g_stage_edge = view.stage_edge_x;
+    const bool up = pad.sub_y >= kCStickUpPress;
+    Out& o = st.out;
+    o = Out{};
+    st.opp_ok = false;
+    if (fighter) {   // the nearest live opponent (any slot, CPUs too; Teams: the other team)
+      int me = view.port_slot[p];
+      if (me < 0) for (int i = 0; i < 4; ++i) if (&view.port[i] == fighter) me = view.port[i].slot;
+      float best = 1e9f;
+      for (int s = 0; s < 4; ++s) {
+        if (s == me || !view.slot_live[s]) continue;
+        if (me >= 0 && me < 4 && view.slot_team[s] >= 0 && view.slot_team[s] == view.slot_team[me]) continue;
+        const float dx = view.slot_x[s] - st.px, dy = view.slot_y[s] - st.py, d = dx * dx + dy * dy;
+        if (d < best) { best = d; st.opp_dx = dx; st.opp_dy = dy; st.opp_ok = true; }
+      }
+    }
+    const bool rest_held = enabled(JigglyRest) && kind == kKindPuff && (pad.button & jump_bit(JigglyRest));
+    if (rest_held) {   // the same button as the up-tilt one: Jigglypuff's is the rest
+      jiggly_rest(o, st, pad, fighter);
+      pad.button &= (uint16_t)~jump_bit(JigglyRest);
+      st.ut_frame = -1; st.ut_was_down = true;
+    } else if (enabled(UpTiltButton)) {   // first: a press it takes is no jump for the other mods
+      const uint16_t bit = jump_bit(UpTiltButton);
+      const bool down = (pad.button & bit) != 0;
+      if (uptilt_button(o, st, pad, fighter, delay)) pad.button &= (uint16_t)~bit;
+      st.ut_was_down = down;
+    } else {
+      st.ut_frame = -1;
+    }
+    if (!rest_held) { st.jr_t = 0; st.jr_close = 0; }
+    // One line per push or press, so a session log shows what the mods saw.
+    if (up && !st.cstick_was_up && pad.err == 0 && enabled(CStickUpJump))
+      host::log("padmods: C-up on controller %d, %s fighter%s motion %d %s", p + 1, online ? "online" : "offline",
+                fighter ? "" : " MISSING,", fighter ? (int)fighter->motion_id : -1,
+                fighter ? (fighter->ground_or_air ? "air" : "ground") : "-");
+    if (enabled(FoxFalcoShine) && (pad.button & kPadB) && !st.b_was_down && pad.err == 0)
+      host::log("padmods: B on controller %d, %s fighter%s kind %d %s", p + 1, online ? "online" : "offline",
+                fighter ? "" : " MISSING,", kind - 1, fighter ? (fighter->ground_or_air ? "air" : "ground") : "-");
+
+    // A jump pressed within the last jumpsquat + delay + 2 frames: the state seen here may still say
+    // grounded, but the fighter is (about to be) in the air, so no ground move may start.
+    // A jump the mods pressed (a ledgedash, a wavedash) that the view already shows landed in the
+    // waveland lag is over: B in that lag is a shine again (TSC 11-07: Fox ledgedash, down + B lost).
+    const bool mod_jump_landed = st.jump_mod && fighter && fighter->ground_or_air == 0 && fighter->motion_id == kLanding + 1;
+    const bool jumping = st.jump_age <= kJumpsquatFalco + delay + 2 && !mod_jump_landed;
+    const bool tap_jump = pad.stick_y >= kCStickUpPress && !st.stick_was_up;
+    if (((pad.button & (kPadX | kPadY)) & ~st.xy_was_down) || tap_jump) { st.jump_age = 0; st.jump_mod = false; }
+    else if (st.jump_age < 1000) ++st.jump_age;
+    // Their own jump press in a ground shine (the shine wavedash lines its dodge up with it).
+    if ((pad.button & (kPadX | kPadY)) & ~st.xy_was_down) {
+      const bool shine_now = fighter && fox_or_falco(kind) && fighter->ground_or_air == 0 &&
+                             fighter->motion_id >= kShineFirst && fighter->motion_id <= kShineLast;
+      st.shine_jump_age = shine_now ? 0 : 1000;
+      const bool ground_now = fighter && fighter->ground_or_air == 0 && takes_jump(fighter->motion_id);
+      st.ground_jump_age = ground_now && st.gwd_frame < 0 ? 0 : 1000;
+    } else {
+      if (st.shine_jump_age < 1000) ++st.shine_jump_age;
+      if (st.ground_jump_age < 1000) ++st.ground_jump_age;
+    }
+
+    if (enabled(CStickUpJump)) cstick_up_jc_smash(o, st, pad, fighter, kind, jumping); else { st.cs_frame = -1; st.cs_pend = -1; }
+    const bool oos = (enabled(ShieldUpB) || enabled(ShieldShine) || enabled(ZeldaShieldNayru)) && shield_b(o, st, pad, fighter, kind, jumping, facing);
+    if (!enabled(ShieldUpB) && !enabled(ShieldShine) && !enabled(ZeldaShieldNayru)) { st.oos_frame = -1; st.oos_wait = -1; }
+    const bool ms = !oos && enabled(Multishine) && multishine(o, st, pad, fighter, kind, delay);
+    if (!enabled(Multishine)) { st.ms_frame = -1; st.ms_wait = -1; }
+    if (oos || ms) { st.shine_frame = -1; st.shine_wait = -1; }   // this B is the shield's, or the multishine's
+    else if (enabled(FoxFalcoShine)) fox_falco_shine(o, st, pad, fighter, kind, jumping, delay);
+    else { st.shine_frame = -1; st.shine_wait = -1; }
+    // Not during a multishine: a B tapped in its jumpsquat armed the laser loop, which pulled the stick
+    // into the laser zone on the shine's frame (lab 11-09: the second multishine came out a laser).
+    if (enabled(FoxLaserLoop) && !ms && st.ms_frame < 0) fox_laser_loop(o, st, pad, fighter, kind, facing);
+    else { st.lz_armed = false; st.lz_frame = -1; st.lz_jsb = -1; }
+    if (enabled(HoldLaser) && !ms && !oos) hold_laser(o, st, pad, fighter, kind, facing); else { st.hl_on = false; st.hl_t = 0; }
+    const bool rjc = enabled(RunJcGrab) && run_jc_grab(o, st, pad, fighter, jumping);
+    if (!enabled(RunJcGrab)) st.rjc_frame = -1;
+    if (rjc) {
+      st.z_since = -1;   // this Z is the run grab's
+    } else if (enabled(ZAlwaysGrabs)) {
+      if (!shine_z_grab(o, st, pad, fighter, kind, facing, jumping, delay))
+        z_always_grabs(o, st, pad, fighter, shield, delay, jumping);
+    } else {
+      st.grab_frame = -1; st.z_since = -1;
+    }
+    if (st.oos_shine_recent > 0) --st.oos_shine_recent;
+    const bool rj = enabled(RunJab) && run_jab(o, st, pad, fighter, delay);
+    if (!enabled(RunJab)) st.rj_frame = -1;
+    if (enabled(HoldJab) && !rj) hold_jab(o, st, pad, fighter, kind); else { st.hj_held = 0; st.hj_t = 0; }
+    if (enabled(FalconGentleman)) falcon_gentleman(o, st, pad, fighter, kind, delay);
+    else { st.gj_motion = -1; st.gj_count = 0; st.gj_phase = 0; st.gj_want = false; }
+    if (enabled(SamusSuperWavedash)) samus_swd(o, st, pad, fighter, kind, delay);
+    else { st.swd_dir = 0; st.swd_go = st.swd_hide_b = false; }
+    const bool stall = enabled(LedgeStall) && ledge_stall(o, st, pad, fighter, kind, delay);
+    if (!enabled(LedgeStall)) { st.us_frame = -1; st.us_stopped = false; }
+    const bool ledge = !stall && enabled(LedgeDash) && ledge_dash(o, st, pad, fighter, kind, facing, delay);
+    if (!enabled(LedgeDash)) { st.ld_frame = -1; st.ld_wait = -1; }
+    if (enabled(ShineWavedash) && !ledge) shine_wavedash(o, st, pad, fighter, kind, delay); else st.wd_frame = -1;
+    // Their jump in a ground shine with the stick pushed back: the stick turns the shine around first
+    // (SpecialLwTurn), which eats the jump (lab 11-09: Y + stick back in the Loop, 364 then End, no
+    // jump). On that frame the stick's backward part is held at center, as for the R wavedash's jump.
+    if (enabled(ShineWavedash) && !ledge && !o.set_stick && fighter && fox_or_falco(kind) &&
+        fighter->ground_or_air == 0 && fighter->motion_id >= kShineFirst && fighter->motion_id <= kShineLast &&
+        ((pad.button | o.add) & ~st.xy_was_down & (kPadX | kPadY)) && pad.stick_x * (facing < 0.0f ? -1 : 1) < 0) {
+      o.set_stick = true; o.sx = 0; o.sy = pad.stick_y > 0 ? pad.stick_y : 0;
+    }
+    // A shine's L/R belongs to the shine wavedash; a pending shine move keeps the R for itself.
+    const bool in_any_shine = fighter && fox_or_falco(kind) &&
+                              ((fighter->motion_id >= kShineFirst && fighter->motion_id <= kShineLast) ||
+                               (fighter->motion_id >= kAirShineFirst && fighter->motion_id <= kAirShineLast));
+    // Always run (its "R never shields on the ground" rule too); only starting a wavedash waits for a
+    // shine move or a C-stick up-smash in progress (TSC 11-06: R held through a C-up gave a shield).
+    if (enabled(GroundWavedash) && !ledge && (st.gwd_frame >= 0 || !in_any_shine))
+      ground_wavedash(o, st, pad, fighter, kind, jumping, delay, facing,
+                      st.wd_frame == -1 && st.cs_frame == -1 && st.cs_pend == -1);
+    else if (!enabled(GroundWavedash)) { st.gwd_frame = -1; st.gwd_pending = -1; }
+    // The slide walk never touches a move another mod is making, or a jump: a new R wavedash out of a
+    // backward slide (R held = the walk) had its air dodge angle replaced by the walk's (23, 0), a flat
+    // air dodge in the air (TSC 11-07, Ganon: "auto wd and it randomly airdodges", trace 24x6 236x32).
+    const bool fresh_trig = (pad.button & ~st.buttons_was_down & (kPadL | kPadR)) != 0;
+    const bool other_move = st.gwd_frame >= 0 || st.gwd_pending >= 0 || st.wd_frame != -1 || st.ld_frame >= 0 ||
+                            st.cs_frame != -1 || st.cs_pend >= 0 || jumping || fresh_trig ||
+                            (fighter && fighter->motion_id == kKneeBend);
+    if (enabled(SlideStretch) && !other_move) slide_walk(o, st, pad, fighter, kind, facing, vel_x);
+    else { st.sw_armed = false; st.sw_walk = 0; }
+    {
+      uint16_t exclude = 0;
+      if (enabled(ZAlwaysGrabs)) exclude |= kPadZ;
+      if (enabled(FoxFalcoShine) && fox_or_falco(kind)) exclude |= kPadB;
+      lag_buffer(o, st, pad, fighter, exclude);
+    }
+
+    // Smooth hand-back (human timing): the frame after the mods let the stick go, it is halfway
+    // between where they had it and where the player's is, then the player's.
+    if (!o.set_stick && st.sent_override && human()) {
+      halfway(o, st.sent_sx, st.sent_sy, pad.stick_x, pad.stick_y);
+      st.sent_override = false;
+    } else {
+      st.sent_override = o.set_stick;
+    }
+    if (o.set_stick) { st.sent_sx = o.sx; st.sent_sy = o.sy; }
+
+    if ((o.add & (kPadX | kPadY)) & ~pad.button) { st.jump_age = 0; st.jump_mod = true; }   // a jump the mods pressed
+    st.stick_was_up = pad.stick_y >= kCStickUpPress;
+    st.cstick_was_up = up;
+    st.b_was_down = (pad.button & kPadB) != 0;
+    st.buttons_was_down = pad.button;
+    st.cstick_was_pushed = (pad.sub_x * pad.sub_x + pad.sub_y * pad.sub_y) >= kCStickUpPress * kCStickUpPress;
+    st.xy_was_down = (uint16_t)(pad.button & (kPadX | kPadY));
+    st.z_was_down = (pad.button & kPadZ) != 0;
+    st.lr_was_down = lr_down(pad);
+    st.r_was_down = r_down(pad);
+    st.trig_l_was = pad.trig_l; st.trig_r_was = pad.trig_r;
+    put(pad, o);
+    if (st.trace_left > 0) {   // R wavedash trace: motion runs, so a long stall shows in the log
+      const int mo = fighter ? (int)fighter->motion_id : -1;
+      auto flush = [&] {
+        if (st.trace_motion < 0) return;
+        const size_t n = std::strlen(st.trace);
+        if (n < sizeof st.trace - 16)
+          std::snprintf(st.trace + n, sizeof st.trace - n, "%s%d%s", n ? " " : "", st.trace_motion,
+                        st.trace_run > 1 ? ("x" + std::to_string(st.trace_run)).c_str() : "");
+      };
+      if (mo != st.trace_motion) { flush(); st.trace_motion = mo; st.trace_run = 1; } else ++st.trace_run;
+      if (--st.trace_left == 0) { flush(); host::log("padmods: R wavedash trace (motion x frames): %s", st.trace); }
+    }
+    {   // follow the game's last-flick memory from the stick actually sent (see PortState)
+      int gx, gy;
+      game_stick(pad.stick_x, pad.stick_y, gx, gy);
+      float x = (float)gx / kStickRadius;
+      if (std::fabs(x) <= 0.28f) x = 0.0f;   // horizontal_stick_deadzone, applied before the test
+      if (st.flick_age < 255) ++st.flick_age;
+      if (x >= 0.25f && st.flick_prev_x < 0.25f) { st.flick_dir = 1; st.flick_age = 0; }
+      else if (x <= -0.25f && st.flick_prev_x > -0.25f) { st.flick_dir = -1; st.flick_age = 0; }
+      st.flick_prev_x = x;
+    }
+  }
+}
