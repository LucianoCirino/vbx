+// MuLcancelView::fighter_kind is Ft_Kind + 1 (melee/src/melee/ft/forward.h).
+constexpr int32_t kKindFox = 0x01 + 1, kKindFalco = 0x16 + 1;
+// Jumpsquat (KneeBend) length: the first airborne frame comes this long after the jump press.
+constexpr int kJumpsquatFox = 3, kJumpsquatFalco = 5;
+// Every fighter's, by Ft_Kind: ftData attributes +0x38 (jump_startup_time) of each Pl*.dat on the
+// NTSC 1.02 disc, read 2026-11-06.
+constexpr int8_t kJumpsquatByKind[0x1B] = {
+    4, 3, 4, 5, 3, 8, 6, 3, 4, 5, 3, 3, 3, 3, 5, 5, 5, 4, 4, 6, 4, 4, 5, 3, 4, 6, 5};
+int jumpsquat_of(int32_t kind) {   // kind = Ft_Kind + 1; unknown: 0 (no jumpsquat known)
+  return (kind >= 1 && kind <= 0x1B) ? kJumpsquatByKind[kind - 1] : 0;
+}
