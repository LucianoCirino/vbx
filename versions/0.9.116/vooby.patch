+      if (ImGui::SmallButton("Unblock")) { slippi::online::config().blocked_codes[own_slot[i]].clear(); changed = true; }
+      ImGui::PopID();
+    }
+    for (size_t i = 0; i < codes.size(); ++i) {
+      ImGui::TableNextRow();
+      ImGui::PushID((int)i);
+      ImGui::TableNextColumn(); ImGui::TextUnformatted(codes[i].c_str());
+      ImGui::TableNextColumn(); { const std::string n = name_of(codes[i]); ImGui::TextUnformatted(n.c_str()); }
+      ImGui::TableNextColumn(); if (ImGui::SmallButton("Unblock")) erase = (int)i;
+      ImGui::PopID();
