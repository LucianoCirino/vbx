+  if (ImGui::BeginTable("##blocked", 3, kTable)) {
+    ImGui::TableSetupColumn("Code", ImGuiTableColumnFlags_WidthStretch, 1.0f);
+    ImGui::TableSetupColumn("Name", ImGuiTableColumnFlags_WidthStretch, 1.4f);
+    ImGui::TableSetupColumn("", ImGuiTableColumnFlags_WidthFixed, 96 * s);
+    ImGui::TableHeadersRow();
+    int erase = -1;
+    for (size_t i = 0; i < own.size(); ++i) {
+      ImGui::TableNextRow();
+      ImGui::PushID(500 + (int)i);
+      ImGui::TableNextColumn(); ImGui::TextUnformatted(own[i].c_str());
+      ImGui::TableNextColumn(); { const std::string n = name_of(own[i]); ImGui::TextUnformatted(n.c_str()); }
