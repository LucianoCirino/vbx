+  uint8_t trig_l_was = 0, trig_r_was = 0;   // last frame's analog triggers
+  uint16_t gwd_button = kPadR, ld_button = kPadR;
+  // short hop buttons, [0] Y [1] X: frames since the press (-1 off)
+  // Z while dashing/running: frames since the jump (-1 off)
+  int rjc_frame = -1;
+  // Fox laser loop: armed while B is held after an air laser; frame in the current hop (-1: waiting
+  // to land and be able to act); whether the view has seen this hop in the air
