diff --git a/port/runtime/host/ai_takeover.cpp b/port/runtime/host/ai_takeover.cpp
new file mode 100644
index 0000000..afa709c
--- /dev/null
+++ b/port/runtime/host/ai_takeover.cpp
@@ -0,0 +1,411 @@
+// Vooby Mods' AI takeover: see ai_takeover.h.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "ai_takeover.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <cstdlib>
+#include <mutex>
+
+#include "ghost_ai.h"
+#include "../abi/mu_ghost_ai.h"
+#include "../abi/mu_practice_cpu.h"
+#include "pad_mods.h"
+#include "slippi_online.h"
+#include "practice_ghosts.h"
+
+namespace ai_takeover {
+namespace {
+
+// One player's post-frame event (payload offsets: the event without its command byte, big endian,
+// as sourceport/game/shim/mu_replay.c mu_replay_post_frame writes it).
+struct Post {
+  bool have = false;
+  int32_t frame = 0;
+  uint8_t player = 0, kind = 0, stocks = 0, jumps = 0, airborne = 0, hurtbox = 0;
+  uint16_t motion = 0;
+  float x = 0, y = 0, facing = 1, percent = 0, shield = 60, anim = 0, misc = 0;
+  float self_x = 0, self_y = 0, kb_x = 0, kb_y = 0, gr = 0, hitlag = 0;
+  uint8_t flags[5] = {};
+};
+
+std::mutex g_mu;
+Post g_post[4];          // the leader of each player slot (Nana is left out)
+int g_stage = 0;         // Slippi stage id from Game Start (31 Battlefield, 32 Final Destination ...)
+bool g_teams = false;    // a teams match: the AI plays against the other team only
+uint8_t g_team[4] = {};  // each player's team id
+int32_t g_match = 0;     // bumped on each Game Start: the AIs forget what came before
+int32_t g_last_frame = -1000;
+uint32_t g_post_retrace = 0;   // the pad read when the last post-frame came
+bool g_from_snapshot = false;  // this match's AI reads the state snapshot (no replay recorded)
+int g_snap_jumps[4] = {};
+uint32_t g_snap_epoch = 0;   // the pad read the snapshot's match began on (its frame -123, as a replay's)
+bool g_snap_any = false;
+int g_slot_port[4] = {-1, -1, -1, -1};
+char g_label[4][24] = {};   // the badge name per controller (label())
+int g_target[4] = {-1, -1, -1, -1};   // the slot each controller's AI is after
+bool g_manual[4] = {};               // ...picked with the D-pad: no automatic switch   // each slot's controller, from the snapshot
+
+uint32_t be32(const uint8_t* p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+float bef(const uint8_t* p) { const uint32_t u = be32(p); float f; std::memcpy(&f, &u, 4); return f; }
+
+// The practice CPU's model memory per controller, and the pro AI's last controller (what the
+// network remembers holding).
+MuPcState g_state[4];
+int32_t g_state_match[4] = {-1, -1, -1, -1};
+MuGhostAct g_applied[4];
+int32_t g_ghost_match[4] = {-1, -1, -1, -1};
+
+int pro_count() { return (int)(sizeof practice_ghosts::kGhosts / sizeof practice_ghosts::kGhosts[0]); }
+bool pro_ok(int i) {
+  return i >= 0 && i < pro_count() && practice_ghosts::kReleased[i] && ghost_ai::specialist_available((unsigned)i);
+}
+
+// Slippi stage id -> the game's internal stage id (what mu_pc_stage_ledge takes).
+int internal_stage(int slippi) {
+  switch (slippi) {
+    case 2: return 0x0C; case 3: return 0x10; case 8: return 0x0A;
+    case 28: return 0x1C; case 31: return 0x24; case 32: return 0x25; default: return -1;
+  }
+}
+
+void to_ghost(const Post& p, MuGhostFighter& g) {
+  std::memset(&g, 0, sizeof g);
+  g.num[0] = p.x; g.num[1] = p.y; g.num[2] = p.facing; g.num[3] = p.percent; g.num[4] = p.shield;
+  g.num[5] = (float)p.stocks; g.num[6] = p.anim; g.num[7] = p.misc; g.num[8] = p.airborne ? 1.0f : 0.0f;
+  g.num[9] = (float)p.jumps; g.num[10] = p.self_x; g.num[11] = p.self_y; g.num[12] = p.kb_x;
+  g.num[13] = p.kb_y; g.num[14] = p.gr; g.num[15] = p.hitlag;
+  g.motion = p.motion;
+  g.kind = p.kind;
+  std::memcpy(g.flags, p.flags, 5);
+  g.hurtbox = p.hurtbox;
+}
+
+// As port/runtime/hle/practice_cpu.cpp read_fighter has it, from the post-frame instead of memory.
+void to_pc(const Post& p, MuPcFighter& f) {
+  std::memset(&f, 0, sizeof f);
+  if (!p.have) return;
+  f.present = 1;
+  f.kind = p.kind;
+  f.motion = p.motion;
+  f.facing = p.facing;
+  f.x = p.x; f.y = p.y;
+  f.vx = (p.airborne ? p.self_x : p.gr) + p.kb_x;
+  f.vy = p.self_y + p.kb_y;
+  f.airborne = p.airborne;
+  f.percent = p.percent;
+  f.shield = p.shield;
+  f.hitlag = p.hitlag > 0.0f;
+  f.hitstun = (p.flags[3] & 0x02) != 0;   // x221C_b6
+  f.jumps_left = p.jumps;
+  const int m = p.motion;
+  f.can_act = !f.hitlag && !f.hitstun &&
+              ((p.flags[0] & 0x80) != 0 ||   // allow_interrupt
+               (m >= 14 && m <= 21) || (m >= 27 && m <= 34) || m == 38 || m == 39 || m == 40 || m == 179 ||
+               m == 245 || m == 246);
+}
+
+// A controller as floats (the game's units) -> the raw pad the game reads.
+void to_pad(float lx, float ly, float cx, float cy, float l, float r, uint32_t buttons, host::PadState& out) {
+  auto st = [](float v) { v = std::clamp(v, -1.0f, 1.0f); return (int8_t)std::lround(v * 80.0f); };
+  auto tr = [](float v) { v = std::clamp(v, 0.0f, 1.0f); return (uint8_t)(v <= 0.0f ? 0 : std::min(255L, std::lround(30.0f + v * 150.0f))); };
+  out.button = (uint16_t)(buttons & 0x1F7F);   // the GameCube buttons (MU_PC_* = PAD bits)
+  out.stick_x = st(lx); out.stick_y = st(ly);
+  out.sub_x = st(cx); out.sub_y = st(cy);
+  out.trig_l = tr(l); out.trig_r = tr(r);
+  if (out.button & 0x0040) out.trig_l = 255;   // a click comes with a full press
+  if (out.button & 0x0020) out.trig_r = 255;
+}
+
+}  // namespace
+
+int team_of(int slot) {
+  std::lock_guard<std::mutex> lock(g_mu);
+  return g_teams && slot >= 0 && slot < 4 ? g_team[slot] : -1;
+}
+
+void note_event(uint8_t command, const uint8_t* p, uint32_t size) {
+  std::lock_guard<std::mutex> lock(g_mu);
+  if (command == 0x36) {   // Game Start: a new match
+    for (auto& q : g_post) q = Post{};
+    g_stage = size > 0x14 ? (int)((p[0x12] << 8) | p[0x13]) : 0;
+    // Game Start payload: 0x0C is teams, each player's block at 0x64 + 0x24 * i, team id at +0x09.
+    g_teams = size > 0x0C && p[0x0C] != 0;
+    for (int i = 0; i < 4; ++i) g_team[i] = size > (uint32_t)(0x6D + 0x24 * i) ? p[0x6D + 0x24 * i] : (uint8_t)i;
+    if (pad_mods::enabled(pad_mods::AiTakeover))
+      host::log("ai takeover: match on stage %d, %s (teams %d %d %d %d, characters %d %d)", g_stage, g_teams ? "teams" : "no teams",
+                g_team[0], g_team[1], g_team[2], g_team[3], size > 0x88 ? p[0x64] : -1, size > 0x88 ? p[0x88] : -1);
+    ++g_match;
+    return;
+  }
+  static const bool force_snapshot = std::getenv("MU_AI_FORCE_SNAPSHOT") != nullptr;   // tests: as in Training
+  if (command != 0x38 || size < 0x50 || force_snapshot) return;
+  const uint8_t player = p[0x04];
+  if (player > 3 || p[0x05]) return;   // the leader only (no Nana)
+  Post& q = g_post[player];
+  q.have = true;
+  q.frame = (int32_t)be32(p);
+  q.player = player;
+  q.kind = p[0x06];
+  q.motion = (uint16_t)((p[0x07] << 8) | p[0x08]);
+  q.x = bef(p + 0x09); q.y = bef(p + 0x0D); q.facing = bef(p + 0x11);
+  q.percent = bef(p + 0x15); q.shield = bef(p + 0x19);
+  q.stocks = p[0x20];
+  q.anim = bef(p + 0x21);
+  std::memcpy(q.flags, p + 0x25, 5);
+  { const uint32_t u = be32(p + 0x2A); std::memcpy(&q.misc, &u, 4); }   // the raw word, as the game's obs has it
+  q.airborne = p[0x2E];
+  q.jumps = p[0x31];
+  q.hurtbox = p[0x33];
+  q.self_x = bef(p + 0x34); q.self_y = bef(p + 0x38);
+  q.kb_x = bef(p + 0x3C); q.kb_y = bef(p + 0x40);
+  q.gr = bef(p + 0x44); q.hitlag = bef(p + 0x48);
+  g_last_frame = q.frame;
+  g_post_retrace = host::retrace_count();
+  g_from_snapshot = false;
+}
+
+// The game's internal stage id -> Slippi's (the pro AI's), the inverse of internal_stage.
+int slippi_stage(int internal) {
+  switch (internal) {
+    case 0x0C: return 2; case 0x10: return 3; case 0x0A: return 8;
+    case 0x1C: return 28; case 0x24: return 31; case 0x25: return 32; default: return 0;
+  }
+}
+
+void note_snapshot(const SnapFighter (&slots)[4], int internal_stage) {
+  std::lock_guard<std::mutex> lock(g_mu);
+  for (int s = 0; s < 4; ++s) g_slot_port[s] = slots[s].present ? slots[s].port : -1;
+  const uint32_t now = host::retrace_count();
+  if (now - g_post_retrace < 4 && !g_from_snapshot) return;   // the replay's post-frames are coming: those
+  if (!g_from_snapshot) { ++g_match; host::log("ai takeover: no replay recorded here, reading the state snapshot"); }
+  g_from_snapshot = true;
+  g_stage = slippi_stage(internal_stage);
+  bool any = false;
+  for (int s2 = 0; s2 < 4; ++s2) any |= slots[s2].present;
+  if (any && !g_snap_any) { g_snap_epoch = now; ++g_match; }   // fighters again: a new match (the AIs start over)
+  g_snap_any = any;
+  { static int said = -2; if (said != internal_stage) { said = internal_stage; host::log("ai takeover: snapshot stage %d (0x%X) -> %d", internal_stage, internal_stage, g_stage); } }
+  g_teams = false;
+  for (int s = 0; s < 4; ++s) {
+    const SnapFighter& f = slots[s];
+    Post& q = g_post[s];
+    if (!f.present) { q = Post{}; continue; }
+    const int m = f.action;
+    // Air or ground: the mods' view for a player; else from the action (jumps, falls, aerials,
+    // air dodge, the damage flights, the ledge's own states are ground-like).
+    const bool air = f.air_known ? f.airborne
+                                 : ((m >= 25 && m <= 38) || (m >= 65 && m <= 74) || m == 236 || m == 237 ||
+                                    (m >= 87 && m <= 91) || (f.vy != 0.0f && !(m >= 14 && m <= 24)));
+    if (!air) g_snap_jumps[s] = 2;
+    else if (m == 27 || m == 28) g_snap_jumps[s] = 0;   // JumpAerialF/B: the double jump is spent
+    q.have = true;
+    static const int test_off = std::getenv("MU_TEST_FRAME_OFF") ? std::atoi(std::getenv("MU_TEST_FRAME_OFF")) : 0;   // tests
+    q.frame = (int32_t)(now - g_snap_epoch) - 123 + test_off;   // Slippi's numbering: the AIs read the match clock from it
+    q.player = (uint8_t)s;
+    q.kind = (uint8_t)f.kind;
+    q.motion = (uint16_t)m;
+    q.x = f.x; q.y = f.y; q.facing = f.facing; q.percent = f.percent; q.shield = 60.0f;
+    q.stocks = (uint8_t)f.stocks; q.anim = f.anim; q.misc = 0;
+    std::memset(q.flags, 0, sizeof q.flags);
+    if (m >= 0x4B && m <= 0x5B) q.flags[3] |= 0x02;   // Damage* states: in hitstun
+    q.airborne = air;
+    q.jumps = (uint8_t)g_snap_jumps[s];
+    q.hurtbox = 0;
+    q.self_x = air ? f.vx : 0.0f; q.gr = air ? 0.0f : f.vx;
+    q.self_y = f.vy; q.kb_x = q.kb_y = 0; q.hitlag = 0;
+  }
+}
+
+const char* label(int port) { return port >= 0 && port < 4 ? g_label[port] : ""; }
+int target_slot(int port) { std::lock_guard<std::mutex> lock(g_mu); return port >= 0 && port < 4 ? g_target[port] : -1; }
+
+int slot_of_port(int port) {
+  std::lock_guard<std::mutex> lock(g_mu);
+  for (int s = 0; s < 4; ++s) if (g_slot_port[s] == port) return s;
+  return port;
+}
+int port_of_slot(int slot) {
+  std::lock_guard<std::mutex> lock(g_mu);
+  if (slot >= 0 && slot < 4 && g_slot_port[slot] >= 0) return g_slot_port[slot];
+  return slot;
+}
+
+int pick(int kind) {
+  const int c = pad_mods::ai_choice(kind);
+  if (c >= 0 && c < 0x80 && c < mu_pc_preset_count()) return c;
+  if (c >= 0x80 && pro_ok(c & 0x7F)) return c;
+  for (int i = 0; i < pro_count(); ++i)
+    if (practice_ghosts::kGhosts[i].kind == kind && pro_ok(i)) return 0x80 | i;
+  return 0;
+}
+
+bool drive(int port, host::PadState& out) {
+  // Offline the player slot is the one the controller plays (Training: slot 1 from any port);
+  // online the local player is the match's local player index, whatever controller it is on.
+  const int slot = slippi::online::session_mode() >= 0 ? slippi::online::local_player_index() : slot_of_port(port);
+  Post self, opp;
+  int stage, match;
+  {
+    std::lock_guard<std::mutex> lock(g_mu);
+    if (port < 0 || port > 3 || slot < 0 || slot > 3 || !g_post[slot].have) {
+      static uint32_t said_at = 0;   // why not, now and then
+      if (host::retrace_count() - said_at > 300) {
+        said_at = host::retrace_count();
+        host::log("ai takeover: nothing to play for controller %d (slot %d; fighters %d%d%d%d; slot ports %d %d %d %d; snapshot %d)",
+                  port + 1, slot, (int)g_post[0].have, (int)g_post[1].have, (int)g_post[2].have, (int)g_post[3].have,
+                  g_slot_port[0], g_slot_port[1], g_slot_port[2], g_slot_port[3], (int)g_from_snapshot);
+      }
+      return false;
+    }
+    self = g_post[slot];
+    // Against a fighter of another team: the nearest, but kept. The pro AIs are 1v1 networks and
+    // phillip_ai.cpp restarts one (18 frames standing still) whenever the opponent's character
+    // changes, so in Teams a target flipping with every step froze the fighter again and again
+    // (TSC 11-11: "the ais in teams are dumb"). A new target only when this one is gone (dead, not in
+    // the match) or the other has been under half its distance for a second, 3 s after the last switch.
+    int* target = g_target;
+    static int closer_for[4] = {}, since[4] = {};
+    auto valid = [&](int k) {
+      return k >= 0 && k < 4 && k != slot && g_post[k].have && g_post[k].frame == self.frame &&
+             !(g_teams && g_team[k] == g_team[slot]) && g_post[k].stocks > 0;
+    };
+    auto dist2 = [&](int k) { const float dx = g_post[k].x - self.x, dy = g_post[k].y - self.y; return dx * dx + dy * dy; };
+    int nearest = -1;
+    for (int k = 0; k < 4; ++k) if (valid(k) && (nearest < 0 || dist2(k) < dist2(nearest))) nearest = k;
+    int& t = target[port];
+    ++since[port];
+    // D-pad left/right (pad_mods): the player picks; kept until that opponent is gone.
+    if (const int step = pad_mods::take_ai_target_step(port)) {
+      int pick = t;
+      for (int i = 1; i <= 4; ++i) {
+        const int k = ((t < 0 ? slot : t) + step * i + 8) % 4;
+        if (valid(k)) { pick = k; break; }
+      }
+      if (pick >= 0 && valid(pick)) {
+        if (pick != t) host::log("ai takeover: controller %d targets player %d (D-pad)", port + 1, pick + 1);
+        t = pick; g_manual[port] = true; since[port] = 0; closer_for[port] = 0;
+      }
+    }
+    if (!valid(t)) { t = nearest; g_manual[port] = false; since[port] = 0; closer_for[port] = 0; }
+    else if (!g_manual[port] && nearest >= 0 && nearest != t && dist2(nearest) < 0.25f * dist2(t)) {   // half the distance
+      if (++closer_for[port] >= 60 && since[port] >= 180) {
+        host::log("ai takeover: controller %d switches target to player %d (much closer)", port + 1, nearest + 1);
+        t = nearest; since[port] = 0; closer_for[port] = 0;
+      }
+    } else {
+      closer_for[port] = 0;
+    }
+    if (t >= 0) opp = g_post[t];
+    stage = g_stage;
+    match = g_match;
+  }
+  int choice = pick(self.kind);
+  bool snap;
+  { std::lock_guard<std::mutex> lock(g_mu); snap = g_from_snapshot; }
+  // Without a replay (Training, offline with replay saving off) the pro AIs see too little: no state
+  // flags, shield, hitlag or knockback. Lab 11-10, Fox vs a standing Marth on Yoshi's Story: Cody's
+  // AI did 0% in two runs of a minute; the Balanced practice CPU did 56%. The practice CPU plays there.
+  static const bool test_snap_pro = std::getenv("MU_TEST_SNAP_PRO") != nullptr;   // tests
+  if (snap && (choice & 0x80) && !test_snap_pro) choice = 0;
+  const int err = out.err;
+  if (port >= 0 && port < 4) {   // the badge's name: the pro's first name, or CPU
+    char name[24] = "CPU";
+    if (choice & 0x80) {
+      const char* full = practice_ghosts::kGhosts[choice & 0x7F].name;
+      size_t n = 0;
+      while (full[n] && full[n] != ' ' && n + 1 < sizeof name) { name[n] = full[n]; ++n; }
+      name[n] = 0;
+    }
+    std::memcpy(g_label[port], name, sizeof name);
+  }
+  if (std::getenv("MU_AI_LOG")) {   // tests: what the AI sees, now and then
+    static uint32_t at = 0;
+    if (host::retrace_count() - at >= 60) {
+      at = host::retrace_count();
+      host::log("ai see: port %d slot %d stage %d frame %d self x %.1f y %.1f act %d air %d | opp %d x %.1f y %.1f act %d pct %.0f",
+                port, slot, stage, (int)self.frame, self.x, self.y, (int)self.motion, (int)self.airborne, (int)opp.have,
+                opp.x, opp.y, (int)opp.motion, opp.percent);
+    }
+  }
+  {   // one line per port and match: which AI took over
+    static int32_t said[4] = {-1, -1, -1, -1};
+    static int said_choice[4] = {-1, -1, -1, -1};
+    if (said[port] != match || said_choice[port] != choice) {
+      said[port] = match; said_choice[port] = choice;
+      host::log("ai takeover: controller %d (kind %d) plays as %s%s%s", port + 1, (int)self.kind,
+                (choice & 0x80) ? "pro AI " : "practice CPU ",
+                (choice & 0x80) ? practice_ghosts::kGhosts[choice & 0x7F].name : mu_pc_preset_name(choice),
+                snap && (pick(self.kind) & 0x80) ? " (no replay recorded here: the pro AIs need one)" : "");
+    }
+  }
+
+  if (choice & 0x80) {   // a pro AI
+    MuGhostObs obs;
+    std::memset(&obs, 0, sizeof obs);
+    obs.version = MU_GHOST_VERSION;
+    obs.pro = (unsigned char)(choice & 0x7F);
+    obs.slot = (unsigned char)port;
+    obs.reset = g_ghost_match[port] != match;
+    g_ghost_match[port] = match;
+    obs.stage = (short)((stage == 2 || stage == 3 || stage == 8 || stage == 28 || stage == 31 || stage == 32) ? stage : 0);
+    // The game's own count (gm_GetFrameCount, 0 up), not Slippi's -123: a negative frame wrapped to
+    // 4 billion in phillip_ai.cpp, which then dropped every answer and waited 5 s a frame (TSC 11-10:
+    // AI turned on during the countdown froze the game).
+    obs.frame = (unsigned)(self.frame + 123);
+    obs.match_frame = self.frame;
+    obs.applied = g_applied[port];
+    to_ghost(self, obs.self);
+    to_ghost(opp.have ? opp : self, obs.opp);
+    MuGhostAct act{};
+    if (ghost_ai::act(obs, act)) {
+      act.buttons &= ~MU_GHOST_ACT_OWN_RECOVERY;
+      g_applied[port] = act;
+      to_pad(act.lx, act.ly, act.cx, act.cy, act.l, act.r, act.buttons, out);
+      out.err = (int8_t)err;
+      return true;
+    }
+    // no network answer: the practice CPU below plays
+    static int warned;
+    if (warned++ < 3) host::log("ai takeover: the pro AI gave no controller, the practice CPU plays");
+  }
+
+  MuPcConfig c;
+  std::memset(&c, 0, sizeof c);
+  mu_pc_defaults(&c);
+  c.enabled = 1;
+  if (!(choice & 0x80)) mu_pc_preset(choice, &c);
+  c.enabled = 1;
+  c.freeze = 0;
+  c.recovery = MU_PC_RECOVER_MIX;   // a player's fighter has no game CPU to recover for it
+  MuPcView v;
+  std::memset(&v, 0, sizeof v);
+  to_pc(self, v.cpu);
+  to_pc(opp, v.opp);
+  if (!v.opp.present) v.opp = v.cpu;
+  mu_pc_stage_ledge(internal_stage(stage), &v.ledge_x, &v.ledge_y);
+  v.frame = (uint32_t)(self.frame + 123);   // 0 up, as obs.frame
+  v.land_frames = -1;
+  if (v.cpu.airborne && v.cpu.vy < 0.0f && std::fabs(v.cpu.x) <= v.ledge_x && v.cpu.y >= v.ledge_y - 1.0f)
+    v.land_frames = (int32_t)((v.cpu.y - v.ledge_y) / -v.cpu.vy);
+  if (g_state_match[port] != match) {
+    mu_pc_reset(&g_state[port], 0x9E3779B9u ^ ((uint32_t)match * 2654435761u) ^ (uint32_t)port);
+    g_state_match[port] = match;
+  }
+  MuPcInput in{};
+  if (!mu_pc_frame(&c, &g_state[port], &v, &in)) {
+    to_pad(0, 0, 0, 0, 0, 0, 0, out);   // nothing to do (entering, dead): hands off
+  } else {
+    to_pad(in.lx, in.ly, in.cx, in.cy, in.l, in.r, in.buttons, out);
+  }
+  out.err = (int8_t)err;
+  return true;
+}
+
+}  // namespace ai_takeover
+
+namespace {
+const bool g_registered = (pad_mods::set_ai_driver(&ai_takeover::drive), true);
+}
