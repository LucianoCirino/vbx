+
+  // ---- Jump with Y: the same moves, Y instead of X ----
+  only(pad_mods::GroundWavedash); pad_mods::set_enabled(pad_mods::JumpWithY, true);
+  fighter(3, kFox, kWait, 0); idle();
+  { host::PadState p = pad4({kR}); CHECK((p.button & kY) && !(p.button & kX)); }
+  idle();
+  only(pad_mods::CStickUpJump); pad_mods::set_enabled(pad_mods::JumpWithY, true);
+  fighter(3, kFox, kRun, 0); idle();
+  CHECK(pad4({0, 0, 0, 0, 80}).button == kY); idle();
+  pad_mods::set_enabled(pad_mods::JumpWithY, false);
+
+  // ---- Our Auto L-cancel: its own switch, also in Teams; the game's setting stays as shipped ----
+  CHECK(!lcancel::policy::automatic_allowed(3, true));
+  only(pad_mods::AutoLCancel);
+  CHECK(lcancel::mod_automatic_enabled());
+  CHECK(lcancel::policy::mod_automatic_allowed(3, lcancel::mod_automatic_enabled()));
+  only(pad_mods::CStickUpJump);
+  CHECK(!lcancel::mod_automatic_enabled());
+
+  // ---- The pause: START, or L + R + A (its quit), reach the game as they are, every mod on ----
+  for (int m = 0; m < pad_mods::kCount; ++m) pad_mods::set_enabled(m, true);
+  fighter(3, kFox, kWait, 0); idle();
+  { host::PadState p = pad4({(uint16_t)(kL | kR | kA)}); CHECK(p.button == (kL | kR | kA)); }
+  { host::PadState p = pad4({(uint16_t)(kL | kR | kA | 0x1000)}); CHECK(p.button == (kL | kR | kA | 0x1000)); }
+  { host::PadState p = pad4({0x1000}); CHECK(p.button == 0x1000); }
+  idle();
+  for (int m = 0; m < pad_mods::kCount; ++m) pad_mods::set_enabled(m, false);
+
+  // ---- Zelda: B in shield = Nayru's Love on the first airborne frame (stick at rest) ----
+  {
+    constexpr int kZelda = 0x13 + 1;
+    only(pad_mods::ZeldaShieldNayru); pad_mods::set_enabled(pad_mods::ShieldUpB, true);
+    fighter(3, kZelda, 0xB3, 0); idle(45);
+    int bframe = -1;
+    for (int f = 0; f < 14; ++f) {
+      host::PadState p = pad4({(uint16_t)((f < 2 ? kB : 0) | kL), 70, 0});
+      if (f == 0) CHECK((p.button & kX) && !(p.button & kB));
+      if ((p.button & kB) && bframe < 0) { bframe = f; CHECK(p.stick_x == 0 && p.stick_y == 0); }
+    }
+    CHECK(bframe >= 3);   // not inside the jumpsquat (that would be up-B's path)
+    idle(45);
+    // Marth with the same switches: still up-B.
+    fighter(3, kMarth, 0xB3, 0); idle(45);
+    pad4({(uint16_t)(kB | kL), 70, 0});
+    { host::PadState p = pad4({(uint16_t)(kB | kL), 70, 0}); CHECK((p.button & kB) && p.stick_y == 55); }
+    idle(45);
+  }
+  // ---- A in a run: crouch, then a jab (A with the stick at rest) ----
+  only(pad_mods::RunJab);
+  fighter(3, kMarth, kRun, 0); idle(30);
+  { host::PadState p = pad4({kA, 80, 0}); CHECK(!(p.button & kA) && p.stick_y == -56 && p.stick_x == 0); }
+  state(3, 39, 0);   // Squat
+  { host::PadState p = pad4({kA, 80, 0}); CHECK((p.button & kA) && p.stick_x == 0 && p.stick_y == 0); }
+  { host::PadState p = pad4({kA, 80, 0}); CHECK((p.button & kA) && p.stick_x == 0 && p.stick_y == 0); }
+  { host::PadState p = pad4({kA, 80, 0}); CHECK(p.stick_x == 0 && (p.button & kA)); }   // their A held, stick at rest one more frame
+  { host::PadState p = pad4({kA, 80, 0}); CHECK(p.stick_x == 80); }   // done: theirs again
+  idle(30);
+  fighter(3, kMarth, kWait, 0); idle(30);
+  { host::PadState p = pad4({kA, 0, 0}); CHECK((p.button & kA)); }    // standing: their A
+  idle(30);
+  // ---- Hold A: after 8 frames held in a jab, A goes up and down; a tap is untouched; not Falcon ----
+  only(pad_mods::HoldJab);
+  for (int32_t k : {kMarth, (int32_t)(0x02 + 1)}) {
+    fighter(3, k, kWait, 0); idle(30);
+    pad4({kA}); state(3, kAttack, 0);
+    int ups = 0;
+    for (int f = 0; f < 30; ++f) { host::PadState p = pad4({kA}); if (!(p.button & kA)) ++ups; if (f < 8) CHECK(p.button & kA); }
+    if (k == kMarth) CHECK(ups >= 10); else CHECK(ups == 0);
+    idle(30);
+  }
+  fighter(3, kMarth, kWait, 0); idle(30);
+  pad4({kA}); state(3, kAttack, 0);
+  for (int f = 0; f < 4; ++f) CHECK(pad4({kA}).button & kA);
+  for (int f = 0; f < 10; ++f) CHECK(!(pad4({}).button & kA));        // a tap: nothing added
+  idle(30);
+
+  // ---- Jigglypuff: the free X/Y button held = Rest once an opponent is in range ----
+  {
+    constexpr int kPuff = 0x0F + 1;
+    only(pad_mods::JigglyRest);
+    const uint16_t rb = pad_mods::enabled(pad_mods::JumpWithY) ? kX : kY;
+    fighter(3, kPuff, kWait, 0); view.port_slot[3] = 3; view.pos_x[3] = 0; view.pos_y[3] = 0; idle(30);
+    view.slot_live[1] = 1; view.slot_x[1] = 40; view.slot_y[1] = 0; view.slot_team[1] = -1; view.slot_team[3] = -1;
+    for (int f = 0; f < 4; ++f) { host::PadState p = pad4({rb}); CHECK(!(p.button & (kB | kX | kY)) && p.stick_x == 0); }   // far: nothing, no jump
+    view.slot_x[1] = 6;   // pushed against them, out of reach: close in (a frame at rest, then all the way)
+    { host::PadState p = pad4({rb}); CHECK(!(p.button & kB) && p.stick_x == 0); }
+    { host::PadState p = pad4({rb}); CHECK(!(p.button & kB) && p.stick_x == 80); }
+    view.slot_x[1] = 2;
+    int bs = 0;
+    for (int f = 0; f < 4; ++f) { host::PadState p = pad4({rb}); if (p.button & kB) { ++bs; CHECK(p.stick_y == -80 && p.stick_x == 0); } }
+    CHECK(bs == 2);
+    { host::PadState p = pad4({}); CHECK(!(p.button & kB)); }   // let go: nothing
+    // same team (Teams): not an opponent
+    view.slot_team[1] = 0; view.slot_team[3] = 0;
+    for (int f = 0; f < 4; ++f) CHECK(!(pad4({rb}).button & kB));
+    view.slot_team[1] = view.slot_team[3] = -1;
+    // not Jigglypuff: the button is untouched
+    fighter(3, kFox, kWait, 0); idle(30);
+    CHECK(pad4({rb}).button & rb);
+    idle(30); view.slot_live[1] = 0; view.port_slot[3] = 0;
+  }
+
+  CHECK(range_violations == 0);
+  std::puts("pad_mods: ok");
+  return 0;
+}
