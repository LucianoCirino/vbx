+  if (!loaded) { codes = read_blocked(); loaded = true; }
+  if (ImGui::GetTime() - read_at > 2.0) { recent = read_recent(); read_at = ImGui::GetTime(); }
+  const auto name_of = [&](const std::string& code) -> std::string {
+    for (const auto& m : recent) if (clean_code(m.code.c_str()) == code) return m.name;
+    return "";
+  };
+  std::vector<std::string> own;   // the game's own skip list (Online settings), its slot per row
+  std::vector<int> own_slot;
