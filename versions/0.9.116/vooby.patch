+// ---- Holding the wavedash button after a backward wavedash: a very slow forward walk
+// The walk: while walking forward but still sliding backward the game applies the walk's own
+// acceleration (stick_x * walk_accel_mul + walk_accel_base) and NOT ground friction
+// (ftCommon_CalcGroundAccel_DashRun: gr_vel * accel < 0 skips the friction cases). The slowest walk
+// is the stick at 23 (0.2875: just past the 0.28 deadzone, above walk_stick_threshold 0.18), and for
+// a few fighters its drag is below their friction (disc, 11-06, attrs +0x0/+0x4/+0x18):
+//   Ganondorf 0.023 vs 0.070 (3.0x longer braking), Marth and Roy 0.043 vs 0.060 (1.39x),
+//   Bowser 0.059 vs 0.060 (1.02x, left out); everyone else's slow walk brakes harder than friction.
+bool slow_walk_gains(int32_t kind) { return kind == 0x19 + 1 || kind == 0x12 + 1 || kind == 0x1A + 1; }
+constexpr int kSlowWalkX = 23;
+// The slide after any wavedash or waveland (TSC 11-06: "I just want a proper way to tilt backwards
+// from the slide", replacing the hold-R version): for a fighter it helps, while the fighter slides
+// BACKWARD (the game's speed, MuFighterState vel_x, against the facing), a stick tilted backward (the
+// way of the slide) is sent as the very slow forward walk that stretches the slide (23 * facing,
+// with a halfway frame in). A neutral or forward stick is theirs. When the slide stops, or in the
+// air, the stick is theirs again (held back, it then turns them as usual).
+void slide_walk(Out& o, PortState& st, const host::PadState& pad, const MuLcancelFighter* fighter, int32_t kind,
+                float facing, float vel_x) {
+  const int32_t m = fighter ? fighter->motion_id : -1;
+  if (!st.sw_armed && m == kLanding + 1 && st.sw_prev_motion != kLanding + 1 && slow_walk_gains(kind)) {
+    st.sw_armed = true; st.sw_frames = 0; st.sw_walk = 0; st.sw_saw_vel = false; st.sw_r_cancel = false;
+  }
+  st.sw_prev_motion = m;
+  if (!st.sw_armed) return;
+  const int face = facing < 0.0f ? -1 : 1;
+  ++st.sw_frames;
+  if (std::fabs(vel_x) > 0.3f) st.sw_saw_vel = true;
+  const bool ground = fighter && fighter->ground_or_air == 0;
+  const bool lag = m == kLanding + 1;
+  const bool backward = st.sw_saw_vel && vel_x * face < -0.05f;
+  // A forward slide (a ledgedash, a forward waveland) is never stretched, in the lag either: with R
+  // still held from the ledgedash the walk took their stick, and their down + B came out as a neutral
+  // B (TSC 11-07). And a press held back for them in the lag (lag_buffer) is aimed by THEIR stick.
+  const bool forward = st.sw_saw_vel && vel_x * face > 0.05f;
+  const bool press_pending = st.buf_bits || st.buf_c || st.buf_send > 0 ||
+                             (pad.button & ~st.buttons_was_down & (kPadA | kPadB | kPadZ | kPadX | kPadY)) != 0;
+  if (!ground || forward || press_pending || (!lag && !backward)) {   // the slide is over (or in the air): theirs
+    if (st.sw_walk > 0 && ground && !press_pending) halfway(o, kSlowWalkX * face, 0, pad.stick_x, pad.stick_y);
+    st.sw_armed = false; st.sw_walk = 0;
+    return;
+  }
+  int gx, gy;
+  game_stick(pad.stick_x, pad.stick_y, gx, gy);
+  // Only a deliberate gentle level tilt back (23..55 of 80 sideways, under the deadzone up/down):
+  // a full push back is a dash back or a turn, and the down-back angle left from their own air dodge
+  // is theirs (TSC 11-06: "my normal wavedashes still screwing up").
+  const bool tilt_back = gx * face <= -kStickDeadzone && gx * face >= -55 && std::abs(gy) < kStickDeadzone;
+  // Or the wavedash button held (TSC 11-06: "wavelands are still not working on R hold"): the walk
+  // takes the stick for the slide. Held back, down-back, down or let go is still the walk (TSC 11-06:
+  // the fast fall + down-back dodge, then the stick kept back while R stays held, dropped the walk
+  // when it was any move away from the dodge angle); only a push forward or up is theirs, for the
+  // rest of that hold.
+  const bool r_held = trig_down(pad, trig_sel(SlideStretch));
+  if (!r_held) st.sw_r_cancel = false;
+  bool r_walk = r_held && !st.sw_r_cancel;
+  if (r_walk && st.sw_walk > 0 && (gx * face >= kStickDeadzone || gy >= kStickDeadzone)) {
+    st.sw_r_cancel = true; r_walk = false;
+  }
+  if (!tilt_back && !r_walk) {
+    if (st.sw_walk > 0 && !st.sw_r_cancel) halfway(o, kSlowWalkX * face, 0, pad.stick_x, pad.stick_y);
+    st.sw_walk = 0;
+    return;
+  }
+  if (st.sw_walk == 0) { st.sw_ref_x = pad.stick_x; st.sw_ref_y = pad.stick_y; }
+  const int wx = kSlowWalkX * face;
+  if (st.sw_walk++ == 0) halfway(o, pad.stick_x, pad.stick_y, wx, 0);
+  else { o.set_stick = true; o.sx = (int8_t)wx; o.sy = 0; }
+}
+
+// ---- After a mod wavedash: the landing lag's presses go in when the fighter can act
+// Melee has no buffer: a press during the waveland's lag (LandingFallSpecial, PlCo x344 = 10
+// frames, no IASA) is simply lost, so "A fast out of a wavedash" was eaten (TSC, Ganon). For
+// kLagBufferWindow frames after the dodge, a fresh A, B, X, Y or C-stick push made while the fighter
+// cannot act is kept from the game and goes in once (2 frames, like a finger) on the first frame
+// the view shows it able to act; their stick at that moment aims it. Z belongs to Z-always-grabs and
+// a Fox/Falco B to the shine mod when those are on. Dropped if the fighter never gets to act.
+bool can_act(const MuLcancelFighter& f) {
+  if (f.ground_or_air != 0) return f.motion_id != 236 && f.motion_id != kKneeBend;   // in the air: not mid air dodge
+  const int32_t m = f.motion_id;
+  if (m == kLanding) return f.anim_frame >= kNormalLandingLag;
+  return takes_jump(m) || m == kOttotto || m == kOttotto + 1;
+}
+void lag_buffer(Out& o, PortState& st, const host::PadState& pad, const MuLcancelFighter* fighter, uint16_t exclude) {
+  const bool cpush = (pad.sub_x * pad.sub_x + pad.sub_y * pad.sub_y) >= kCStickUpPress * kCStickUpPress;
+  if (st.buf_send > 0) {   // sending the held-back press
+    --st.buf_send;
+    o.add |= st.buf_bits;
+    if (st.buf_c) { o.set_cstick = true; o.cx = cpush ? pad.sub_x : st.buf_cx; o.cy = cpush ? pad.sub_y : st.buf_cy; }
+    if (st.buf_send == 0) { st.buf_bits = 0; st.buf_c = false; }
+    return;
+  }
+  if (st.buf_window <= 0) { st.buf_bits = 0; st.buf_c = false; st.buf_need_land = false; return; }
+  --st.buf_window;
+  if (!fighter) { st.buf_window = 0; return; }
+  // The view is a frame behind the game: when it shows the waveland lag's 10th and last frame
+  // (PlCo x344 = 10), the frame this pad goes into is the first that can act, so it goes now.
+  if (fighter->motion_id == kLanding + 1 && fighter->ground_or_air == 0) ++st.buf_lag_seen; else if (st.buf_lag_seen && !can_act(*fighter)) st.buf_lag_seen = 0;
+  const bool ready = (can_act(*fighter) && !(st.buf_need_land && fighter->ground_or_air != 0)) ||
+                     st.buf_lag_seen >= kWavelandLag;
+  if (ready && (st.buf_bits || st.buf_c)) {
+    host::log("padmods: wavedash lag buffer: press let through as %s can act (motion %d)", "the fighter",
+              (int)fighter->motion_id);
+    st.buf_send = 2;
+    st.buf_window = 0;
+    lag_buffer(o, st, pad, fighter, exclude);
+    return;
+  }
+  if (ready) return;
+  const uint16_t fresh = (uint16_t)(pad.button & ~st.buttons_was_down & (kPadA | kPadB | kPadX | kPadY) & ~exclude);
+  st.buf_bits |= fresh;
+  if (cpush && !st.cstick_was_pushed) { st.buf_c = true; st.buf_cx = pad.sub_x; st.buf_cy = pad.sub_y; }
+  o.remove |= (uint16_t)(st.buf_bits & pad.button);    // kept from the game while it waits
+  if (st.buf_c) { o.set_cstick = true; o.cx = 0; o.cy = 0; }
+  if (st.buf_window == 0 && (st.buf_bits || st.buf_c)) {
+    host::log("padmods: wavedash lag buffer: dropped, the fighter never got to act (motion %d)", (int)fighter->motion_id);
+    st.buf_bits = 0; st.buf_c = false;
+  }
+}
+
+// ---- Fox: keep holding B after an air laser = short-hop double lasers on a loop
+// MEASURED in this game (headless lab, 11-06: --match Fox, scripted presses, --lcancel-log states,
+// lasers read from the recorded replay's item events), frames from the jump press:
+//   0..2 jumpsquat; 3 first airborne frame: B here starts SpecialAirNStart (344);
+//   Start 3..6, Loop (345) 7..16; laser 1 spawns at 12;
+//   a fresh B on 6..16 (and only then) makes the Loop go again at 17 (isBlasterLoop, set in
+//   ftFox_SpecialN_CheckLoopInput while the script's window cmd_vars[0] is open); laser 2 spawns at
+//   22, the very frame Fox lands (Landing 42), so B 1 cannot be any later than frame 3;
+//   Landing takes a jump again from its anim frame 4 (normal_landing_lag).
+// So each hop: the jump 0..1 (released inside the jumpsquat: a short hop), B 3..4, B 9..10 (the
+// middle of 6..16, so a few frames of online drift either way still land in it). The next hop goes
+// when the view shows Fox on the ground able to act again, after it has seen this hop in the air.
+// Their held B is kept up between the mod's presses (each must be a fresh press). Their stick is
+// theirs except around each B: neutral-B needs |x| < 0.60 and |y| < 0.55 (PlCo x218, x21C), else B is
+// side-B, up-B or a shine, so the stick eases into that zone keeping its direction (a frame halfway,
+// the B frames in it, a frame halfway back), and stays theirs to drift with in between.
+constexpr int32_t kFoxAirNStart = 344, kFoxAirNEnd = 346;
+constexpr int kLaserZoneX = 44, kLaserZoneY = 40;   // 0.55 and 0.50: inside 0.60 / 0.55 with room
+constexpr int kFlickNudge = 26;                     // 0.325: past the 0.25 flick line and the 0.28 deadzone
+// Their stick with any backward part (against `face`) taken off: on the ground a backward stick
+// turns Fox around before the hop, and in the laser's first frame it turns him in the air (seen in
+// the lab: facing flipped on entering SpecialAirNStart with the stick held back).
+void no_back(int& x, int face) { if (x * face < 0) x = 0; }
+// num/den of the way from their stick to the laser zone: |x| <= 0.55, |y| <= 0.50, direction kept,
+// never backward.
+// `from_no_back`: start the blend from their stick with its backward part already off. LAB 11-06:
+// a backward stick on the frame BEFORE the first laser (the halfway frame, -0.5) still turned Fox as
+// the laser started, with the B frame itself at 0; so around the first laser no frame may point back.
+void laser_stick(Out& o, const host::PadState& pad, int num, int den, int face, bool from_no_back = false) {
+  int gx, gy;
+  game_stick(pad.stick_x, pad.stick_y, gx, gy);
+  int bx = gx;
+  no_back(bx, face);
+  if (from_no_back) gx = bx;
+  double k = 1.0;
+  if (std::abs(bx) > kLaserZoneX) k = std::min(k, (double)kLaserZoneX / std::abs(bx));
+  if (std::abs(gy) > kLaserZoneY) k = std::min(k, (double)kLaserZoneY / std::abs(gy));
+  const int tx = (int)(bx * k), ty = (int)(gy * k);
+  blend(o, gx, gy, tx, ty, num, den);
+}
+// In the air with the loop armed, outside a hop's own frames: keep firing until the landing.
+//   a laser looping (SpecialAirNLoop 345 just (re)started, seen from the view): B, 2 frames. The
+//     loop takes a fresh B anywhere from a frame before it starts to 9 frames in (lab: hop frames
+//     6..16 for the loop at 7), and checks nothing but B (ftFox_SpecialN_CheckLoopInput), so their
+//     stick is left alone. It goes again at the loop's end: another laser.
+//   no laser (jumping or falling, 25..34, e.g. the laser ended above the ground or Fox dropped off
+//     a platform): a new laser, B for 2 frames with the stick eased into the laser zone and nothing
+//     backward, after a 2-frame forward roll when the last flick went backward (see the hop).
+void laser_loop_air(Out& o, PortState& st, const host::PadState& pad, const MuLcancelFighter& f, bool loop_start) {
+  const int32_t m = f.motion_id;
+  o.remove |= kPadB;   // their held B: the mod's presses only
+  if (st.lz_refire > 0) { o.add |= kPadB; --st.lz_refire; return; }
+  if (st.lz_newl >= 0) {
+    const int k = st.lz_newl++, off = st.lz_newl_nudge ? 2 : 0;
+    if (k < off) { o.set_stick = true; o.sx = (int8_t)(kFlickNudge * st.lz_face); o.sy = 0; return; }
+    if (k < off + 2) { o.add |= kPadB; laser_stick(o, pad, 1, 1, st.lz_face); return; }
+    if (k == off + 2) { laser_stick(o, pad, 1, 2, st.lz_face, true); return; }
+    st.lz_newl = -1;
+  }
+  if (m == kFoxAirNStart + 1 && loop_start) {
+    st.lz_refire = 1; o.add |= kPadB;   // this frame and the next
+    return;
+  }
+  if (m >= 25 && m <= 34 && st.lz_newl < 0) {   // Jump*, JumpAerial*, Fall*: no laser going
+    st.lz_newl_nudge = st.flick_dir == -st.lz_face && st.flick_age < 22;
+    st.lz_newl = 0;
+    host::log("padmods: laser loop: new laser in the air (motion %d)", (int)m);
+    laser_loop_air(o, st, pad, f, false);
+  }
+}
+
+void fox_laser_loop(Out& o, PortState& st, const host::PadState& pad, const MuLcancelFighter* fighter, int32_t kind,
+                    float facing) {
+  const bool b = (pad.button & kPadB) != 0;
+  // A B pressed in Fox's jumpsquat (counted from their own jump press, so any delay shifts it as a
+  // whole) is held back to the first airborne frame: the only frame a short hop fits both lasers
+  // from (lab: laser 2 spawns on the landing frame). With B still held the loop then arms as usual.
+  constexpr int kFoxJumpsquat = 3;
+  if (st.lz_jsb >= 0) {
+    if (st.jump_age >= kFoxJumpsquat && st.jump_age <= kFoxJumpsquat + 1) {   // the first airborne frame, held 2
+      o.add |= kPadB;
+      laser_stick(o, pad, 1, 1, facing < 0.0f ? -1 : 1);
+      if (st.jump_age == kFoxJumpsquat + 1) st.lz_jsb = -1;
+    } else if (st.jump_age < kFoxJumpsquat) {
+      o.remove |= kPadB;
+      if (st.jump_age == kFoxJumpsquat - 1) laser_stick(o, pad, 1, 2, facing < 0.0f ? -1 : 1);   // on its way
+    } else {
+      st.lz_jsb = -1;
+    }
+    return;
+  }
+  if (!st.lz_armed && kind == kKindFox && b && !st.b_was_down && st.jump_age < kFoxJumpsquat && fighter &&
+      fighter->ground_or_air == 0) {
+    host::log("padmods: laser loop: B in the jumpsquat, held to the first airborne frame");
+    st.lz_jsb = 0;
+    o.remove |= kPadB;
+    return;
+  }
+  if (!st.lz_armed) {
+    if (b && fighter && kind == kKindFox && fighter->ground_or_air == 1 && fighter->motion_id >= kFoxAirNStart &&
+        fighter->motion_id <= kFoxAirNEnd) {
+      st.lz_armed = true; st.lz_frame = -1; st.lz_seen_air = true; st.lz_hops = 0; st.lz_back_frames = 0;
+      st.lz_since_arm = 0; st.lz_since_ground = -1;
+      st.lz_refire = 0; st.lz_newl = -1; st.lz_prev_m = -1;
+      st.lz_face = facing < 0.0f ? -1 : 1;
+      host::log("padmods: laser loop armed (B held in an air laser, facing %s)", st.lz_face > 0 ? "right" : "left");
+    }
+    return;
+  }
+  const bool other = (pad.button & ~st.buttons_was_down & (kPadA | kPadZ | kPadX | kPadY | kPadL | kPadR)) != 0;
+  if (!b || other || !fighter || kind != kKindFox) {
+    host::log("padmods: laser loop stopped after %d hop%s (%s)", st.lz_hops, st.lz_hops == 1 ? "" : "s",
+              !b ? "B let go" : other ? "another button" : "no Fox");
+    st.lz_armed = false; st.lz_frame = -1;
+    return;
+  }
+  const bool ground = fighter->ground_or_air == 0;
+  const int32_t m = fighter->motion_id;
+  const bool loop_start = m == kFoxAirNStart + 1 && (st.lz_prev_m != m || fighter->anim_frame < st.lz_prev_a);
+  ++st.lz_since_arm;
+  if (st.lz_hops == 0 && ground && st.lz_since_ground < 0) st.lz_since_ground = 0;
+  else if (st.lz_since_ground >= 0) ++st.lz_since_ground;
+  st.lz_prev_m = m; st.lz_prev_a = fighter->anim_frame;
+  // In the air outside a hop's own frames (the first laser, a fall, a hop that did not land at 22):
+  // keep firing; the next ready landing starts a hop.
+  if (!ground && (st.lz_frame < 0 || st.lz_frame >= 22)) {
+    st.lz_frame = -1; st.lz_seen_air = true;
+    laser_loop_air(o, st, pad, *fighter, loop_start);
+    return;
+  }
+  if (ground) { st.lz_refire = 0; st.lz_newl = -1; }
+  // Landing and LandingFallSpecial (43: after a laser that ended in the air) both act from anim
+  // frame 4 (ftCo_Landing_IASA, normal_landing_lag); waiting for the next state cost a delay.
+  const bool ready = ground && (((m == kLanding || m == kLanding + 1) && fighter->anim_frame >= kNormalLandingLag) ||
+                                (takes_jump(m) && m != kGuardOn && m != kGuard && m != kLanding && m != kLanding + 1));
+  if (fighter->ground_or_air == 1 && st.lz_frame >= 3) st.lz_seen_air = true;
+  if ((st.lz_frame < 0 || st.lz_frame >= 20) && ready && st.lz_seen_air) {   // a new hop
+    if (st.lz_hops == 0)
+      host::log("padmods: laser loop first hop %d frames after arming, %d after landing (motion %d, anim %.0f)",
+                st.lz_since_arm, st.lz_since_ground, (int)m, fighter->anim_frame);
+    st.lz_frame = 0; st.lz_seen_air = false; ++st.lz_hops;
+  }
+  if (st.lz_frame > 90) {   // never landed able to act: give it back
+    host::log("padmods: laser loop stopped (no landing seen, motion %d)", (int)m);
+    st.lz_armed = false; st.lz_frame = -1;
+    return;
+  }
+  // On the ground (waiting to act, and the jump frames) a backward stick would turn Fox: held off,
+  // through a halfway frame like a thumb easing off.
+  auto hold_off_back = [&] {
+    int gx, gy;
+    game_stick(pad.stick_x, pad.stick_y, gx, gy);
+    if (gx * st.lz_face >= 0) { st.lz_back_frames = 0; return; }
+    int bx = gx; no_back(bx, st.lz_face);
+    const bool first = st.lz_back_frames++ == 0;
+    blend(o, gx, gy, bx, gy, 1, first ? 2 : 1);   // halfway on the first frame, then all the way
+  };
+  if (st.lz_frame < 0) {   // landing lag: waiting to act
+    // Their held B stays up: after the mod's own presses it would reach the game as a fresh press,
+    // a ground laser the moment Fox can act.
+    if (ground) { o.remove |= kPadB; hold_off_back(); } else st.lz_back_frames = 0;
+    return;
+  }
+  const int f = st.lz_frame++;
+  o.remove |= kPadB;   // up between the mod's presses
+  switch (f) {
+    case 0: o.add |= jump_bit(FoxLaserLoop); hold_off_back(); break;
+    // An air neutral-B turns Fox around when the last sideways flick went backward less than 20
+    // frames ago (ftCo_SpecialAir_CheckInput: active_duration.lstick.x < PlCo x224 = 20 and x2228_b7
+    // against the facing). Drifting back does exactly that. Then the stick rolls a little forward
+    // (0.33, past the 0.25 flick line, far from anything else) for frames 1-2 of the jumpsquat:
+    // the last flick is forward when laser 1 starts on frame 3.
+    case 1:
+      o.add |= jump_bit(FoxLaserLoop);
+      if (st.flick_dir == -st.lz_face && st.flick_age < 22) st.lz_nudge = true;
+      if (st.lz_nudge) { o.set_stick = true; o.sx = (int8_t)(kFlickNudge * st.lz_face); o.sy = 0; }
+      else hold_off_back();
+      break;
+    // Laser 1 starts the laser (SpecialAirN_Enter): nothing backward from the ground through it.
+    case 2:
+      if (st.lz_nudge) { o.set_stick = true; o.sx = (int8_t)(kFlickNudge * st.lz_face); o.sy = 0; st.lz_nudge = false; }
+      else laser_stick(o, pad, 1, 2, st.lz_face, true);
+      break;
+    case 3: case 4: o.add |= kPadB; laser_stick(o, pad, 1, 1, st.lz_face); break;
+    case 5: laser_stick(o, pad, 1, 2, st.lz_face, true); break;
+    // Laser 2 only sets the loop flag, which reads nothing but B: their stick stays theirs.
+    case 9: case 10: o.add |= kPadB; break;
+    default: if (ground && f >= 20) hold_off_back(); else st.lz_back_frames = 0; break;
+  }
+}
