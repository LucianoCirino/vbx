+  int gsh_wait = -1;       // "R alone shields": a pushed-stick R kept back, waiting for their jump
+  bool stick_was_up = false;
+  // Z: frames since the last press (-1 off)
+  int z_since = -1, z_tries = 0, z_extra = 0;
