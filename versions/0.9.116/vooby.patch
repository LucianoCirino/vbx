@@ -0,0 +1,633 @@
+// Vooby Mods window (F1 > Game > Vooby Mods > Open): a popup of its own over the settings, with a
+// header, one tab per group and a card per mod. Every control is a real ImGui item (an invisible
+// button drawn over), so mouse, keyboard and controller navigation all work as in the rest of F1.
+// Included from pc_settings.cpp after pc_settings_visuals.inl (settings_heading_font).
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "vooby_mascot.inl"
+
+namespace vooby_ui {
+
+constexpr ImU32 kInk = IM_COL32(236, 240, 250, 255);
+constexpr ImU32 kMuted = IM_COL32(150, 160, 185, 255);
+constexpr ImU32 kCard = IM_COL32(24, 26, 44, 235);
+constexpr ImU32 kCardHover = IM_COL32(32, 35, 58, 240);
+constexpr ImU32 kEdge = IM_COL32(255, 255, 255, 22);
+constexpr ImU32 kPink = IM_COL32(236, 72, 153, 255);
+constexpr ImU32 kViolet = IM_COL32(139, 92, 246, 255);
+constexpr ImU32 kCyan = IM_COL32(34, 211, 238, 255);
+constexpr ImU32 kGreen = IM_COL32(52, 211, 153, 255);
+constexpr ImU32 kAmber = IM_COL32(251, 191, 36, 255);
+constexpr ImU32 kOff = IM_COL32(64, 70, 96, 255);
+
+inline float S() { return ImGui::GetFontSize() / 16.0f; }   // everything scales with the UI font
+
+inline ImU32 mix(ImU32 a, ImU32 b, float t) {
+  auto ch = [&](int s) { return (int)(((a >> s) & 255) + (((int)((b >> s) & 255) - (int)((a >> s) & 255)) * t)); };
+  return IM_COL32(ch(IM_COL32_R_SHIFT), ch(IM_COL32_G_SHIFT), ch(IM_COL32_B_SHIFT), ch(IM_COL32_A_SHIFT));
+}
+
+// Eased 0..1 per id, for switches and highlights.
+inline float ease(ImGuiID id, bool target, float speed = 16.0f) {
+  float v = ImGui::GetStateStorage()->GetFloat(id, target ? 1.0f : 0.0f);
+  v += ((target ? 1.0f : 0.0f) - v) * std::min(1.0f, ImGui::GetIO().DeltaTime * speed);
+  ImGui::GetStateStorage()->SetFloat(id, v);
+  return v;
+}
+
+// A rounded rectangle with a left-to-right gradient (ImGui's multi-colour fill has no rounding).
+inline void grad(ImDrawList* d, ImVec2 a, ImVec2 b, ImU32 c0, ImU32 c1, float rounding, ImDrawFlags flags = 0) {
+  const int v0 = d->VtxBuffer.Size;
+  d->AddRectFilled(a, b, IM_COL32_WHITE, rounding, flags);
+  ImGui::ShadeVertsLinearColorGradientKeepAlpha(d, v0, d->VtxBuffer.Size, a, ImVec2(b.x, a.y), c0, c1);
+}
+
+// A pill switch at the cursor; returns true when flipped.
+inline bool pill(const char* id, bool* value, float scale = 1.0f) {
+  const float s = S() * scale, w = 46 * s, h = 26 * s;
+  ImGui::PushID(id);
+  const bool clicked = ImGui::InvisibleButton("##pill", ImVec2(w, h));
+  if (clicked) *value = !*value;
+  const bool hot = ImGui::IsItemHovered() || ImGui::IsItemFocused();
+  const ImVec2 a = ImGui::GetItemRectMin(), b = ImGui::GetItemRectMax();
+  const float t = ease(ImGui::GetID("t"), *value);
+  ImDrawList* d = ImGui::GetWindowDrawList();
+  if (t > 0.01f) d->AddRectFilled(ImVec2(a.x - 3 * s, a.y - 3 * s), ImVec2(b.x + 3 * s, b.y + 3 * s), mix(0, IM_COL32(236, 72, 153, 55), t), h);
+  grad(d, a, b, mix(kOff, kPink, t), mix(kOff, kViolet, t), h * 0.5f);
+  if (hot) d->AddRect(ImVec2(a.x - 2 * s, a.y - 2 * s), ImVec2(b.x + 2 * s, b.y + 2 * s), IM_COL32(255, 255, 255, 170), h, 0, 1.5f * s);
+  const float r = h * 0.5f - 4 * s;
+  const ImVec2 c(a.x + h * 0.5f + t * (w - h), a.y + h * 0.5f);
+  d->AddCircleFilled(ImVec2(c.x, c.y + 1.5f * s), r, IM_COL32(0, 0, 0, 90), 24);
+  d->AddCircleFilled(c, r, IM_COL32(250, 251, 255, 255), 24);
+  ImGui::PopID();
+  return clicked;
+}
+
+// Segmented buttons ("R | L | R or L"); returns true when the choice changed.
+inline bool segmented(const char* id, int* value, const char* const items[], int count) {
+  const float s = S(), h = 28 * s, pad = 14 * s;
+  ImGui::PushID(id);
+  bool changed = false;
+  ImDrawList* d = ImGui::GetWindowDrawList();
+  float total = 0;
+  for (int i = 0; i < count; ++i) total += ImGui::CalcTextSize(items[i]).x + pad * 2;
+  const ImVec2 o = ImGui::GetCursorScreenPos();
+  d->AddRectFilled(o, ImVec2(o.x + total + 4 * s, o.y + h + 4 * s), IM_COL32(12, 13, 26, 255), 9 * s);
+  float x = o.x + 2 * s;
+  for (int i = 0; i < count; ++i) {
+    const float w = ImGui::CalcTextSize(items[i]).x + pad * 2;
+    ImGui::SetCursorScreenPos(ImVec2(x, o.y + 2 * s));
+    ImGui::PushID(i);
+    if (ImGui::InvisibleButton("##seg", ImVec2(w, h)) && *value != i) { *value = i; changed = true; }
+    const bool hot = ImGui::IsItemHovered() || ImGui::IsItemFocused();
+    const float t = ease(ImGui::GetID("t"), *value == i, 20.0f);
+    const ImVec2 a = ImGui::GetItemRectMin(), b = ImGui::GetItemRectMax();
+    if (t > 0.01f) grad(d, a, b, mix(0, kPink, t), mix(0, kViolet, t), 7 * s);
+    if (hot) d->AddRect(a, b, IM_COL32(255, 255, 255, 150), 7 * s, 0, 1.2f * s);
+    const ImVec2 ts = ImGui::CalcTextSize(items[i]);
+    d->AddText(ImVec2(a.x + (w - ts.x) * 0.5f, a.y + (h - ts.y) * 0.5f), *value == i ? kInk : kMuted, items[i]);
+    ImGui::PopID();
+    x += w;
+  }
+  ImGui::SetCursorScreenPos(ImVec2(o.x, o.y + h + 4 * s));
+  ImGui::Dummy(ImVec2(total + 4 * s, 0));
+  ImGui::PopID();
+  return changed;
+}
+
+inline const char* status_text(ImU32* color) {
+  if (host::gameplay::vanilla_only()) { *color = kAmber; return "VANILLA SESSION"; }
+  if (!pad_mods::all_enabled()) { *color = kOff; return "OFF"; }
+  if (!pad_mods::any_enabled()) { *color = kMuted; return "NOTHING ON"; }
+  if (!pad_mods::allowed_now()) { *color = kAmber; return "PAUSED IN THIS MODE"; }
+  *color = kGreen; return "ACTIVE";
+}
+
+// One mod's card; returns true when something changed.
+inline bool card(int m) {
+  const pad_mods::Info& in = pad_mods::info(m);
+  const float s = S(), padx = 16 * s, pady = 12 * s;
+  ImGui::PushID(m);
+  bool changed = false;
+  ImDrawList* d = ImGui::GetWindowDrawList();
+  const float width = ImGui::GetContentRegionAvail().x;
+  const ImVec2 top = ImGui::GetCursorScreenPos();
+  bool on = pad_mods::enabled(m);
+  const bool opts = on && (pad_mods::has_trigger_choice(m) || pad_mods::has_jump_choice(m) || pad_mods::sub_option_label(m));
+  d->ChannelsSplit(2);
+  d->ChannelsSetCurrent(1);
+  // title + summary
+  const float text_w = width - padx * 2 - 64 * s;
+  ImGui::SetCursorScreenPos(ImVec2(top.x + padx + 6 * s, top.y + pady));
+  ImGui::PushFont(settings_heading_font());
+  const float title_px = 19.0f * s;
+  d->AddText(settings_heading_font(), title_px, ImGui::GetCursorScreenPos(), kInk, in.label, nullptr, text_w);
+  const ImVec2 title_sz = settings_heading_font()->CalcTextSizeA(title_px, FLT_MAX, text_w, in.label);
+  ImGui::PopFont();
+  ImGui::Dummy(ImVec2(text_w, title_sz.y));
+  ImGui::SetCursorScreenPos(ImVec2(top.x + padx + 6 * s, ImGui::GetCursorScreenPos().y + 2 * s));
+  ImGui::PushStyleColor(ImGuiCol_Text, ImGui::ColorConvertU32ToFloat4(kMuted));
+  ImGui::PushTextWrapPos(top.x + padx + 6 * s + text_w - ImGui::GetWindowPos().x);
+  ImGui::TextUnformatted(in.summary);
+  const float text_bottom = ImGui::GetItemRectMax().y;   // where the text really ended
+  ImGui::PopTextWrapPos();
+  ImGui::PopStyleColor();
+  // the "?" with the full description
+  {
+    const ImVec2 q(top.x + width - padx - 46 * s - 30 * s, top.y + pady + 2 * s);
+    ImGui::SetCursorScreenPos(q);
+    ImGui::InvisibleButton("##help", ImVec2(22 * s, 22 * s));
+    const bool hot = ImGui::IsItemHovered() || ImGui::IsItemFocused();
+    d->AddCircle(ImVec2(q.x + 11 * s, q.y + 11 * s), 9.5f * s, hot ? kCyan : IM_COL32(255, 255, 255, 60), 24, 1.4f * s);
+    const ImVec2 qs = ImGui::CalcTextSize("?");
+    d->AddText(ImVec2(q.x + 11 * s - qs.x * 0.5f, q.y + 11 * s - qs.y * 0.5f), hot ? kCyan : kMuted, "?");
+    if (hot) {
+      ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(12 * s, 10 * s));
+      ImGui::BeginTooltip();
+      ImGui::PushTextWrapPos(ImGui::GetFontSize() * 34.0f);
+      ImGui::TextUnformatted(in.help);
+      ImGui::PopTextWrapPos();
+      ImGui::EndTooltip();
+      ImGui::PopStyleVar();
+    }
+  }
+  // the switch
+  ImGui::SetCursorScreenPos(ImVec2(top.x + width - padx - 46 * s, top.y + pady));
+  if (pill("##on", &on)) { pad_mods::set_enabled(m, on); changed = true; }
+  // the options strip, under the text
+  float bottom = 0;
+  bottom = std::max(text_bottom, top.y + pady + 26 * s);
+  if (opts) {
+    float oy = bottom + 10 * s;
+    d->AddLine(ImVec2(top.x + padx + 6 * s, oy - 4 * s), ImVec2(top.x + width - padx, oy - 4 * s), kEdge, 1.0f);
+    float ox = top.x + padx + 6 * s;
+    auto label = [&](const char* t) {
+      ImGui::SetCursorScreenPos(ImVec2(ox, oy + 5 * s + 2 * s));
+      d->AddText(ImGui::GetCursorScreenPos(), kMuted, t);
+      ox += ImGui::CalcTextSize(t).x + 8 * s;
+    };
+    float row_h = 32 * s;
+    if (pad_mods::has_trigger_choice(m)) {
+      static const char* triggers[] = {"R", "L", "R or L"};
+      label("Button");
+      ImGui::SetCursorScreenPos(ImVec2(ox, oy));
+      int c = pad_mods::trigger_choice(m);
+      if (segmented("trig", &c, triggers, 3)) { pad_mods::set_trigger_choice(m, c); changed = true; }
+      ox = ImGui::GetItemRectMax().x + 22 * s;
+    }
+    if (pad_mods::has_jump_choice(m)) {
+      static const char* jumps[] = {"X", "Y"};
+      if (ox + 140 * s > top.x + width - padx) { ox = top.x + padx + 6 * s; oy += row_h + 6 * s; }
+      label(m == pad_mods::UpTiltButton ? "Button" : "Jump");
+      ImGui::SetCursorScreenPos(ImVec2(ox, oy));
+      int c = pad_mods::jump_choice(m);
+      if (segmented("jump", &c, jumps, 2)) { pad_mods::set_jump_choice(m, c); changed = true; }
+      ox = ImGui::GetItemRectMax().x + 22 * s;
+    }
+    if (const char* sub = pad_mods::sub_option_label(m)) {
+      const float need = ImGui::CalcTextSize(sub).x + 60 * s;
+      if (ox + need > top.x + width - padx) { ox = top.x + padx + 6 * s; oy += row_h + 6 * s; }
+      ImGui::SetCursorScreenPos(ImVec2(ox, oy + 3 * s));
+      bool v = pad_mods::sub_option(m);
+      if (pill("##sub", &v, 0.85f)) { pad_mods::set_sub_option(m, v); changed = true; }
+      d->AddText(ImVec2(ImGui::GetItemRectMax().x + 10 * s, oy + 7 * s), v ? kInk : kMuted, sub);
+    }
+    bottom = oy + row_h;
+  }
+  bottom += pady;
+  // background (drawn under the content)
+  d->ChannelsSetCurrent(0);
+  const ImVec2 a = top, b(top.x + width, bottom);
+  const bool hover = ImGui::IsMouseHoveringRect(a, b);
+  const float t = ease(ImGui::GetID("lit"), on, 12.0f);
+  const ImU32 base = hover ? kCardHover : kCard;
+  grad(d, a, b, mix(base, IM_COL32(58, 26, 70, 240), t * 0.8f), mix(base, IM_COL32(30, 28, 66, 240), t * 0.5f), 12 * s);
+  d->AddRect(a, b, mix(kEdge, IM_COL32(236, 72, 153, 120), t), 12 * s, 0, 1.0f);
+  d->AddRectFilled(ImVec2(a.x + 1, a.y + 10 * s), ImVec2(a.x + 5 * s, b.y - 10 * s), mix(kOff, kPink, t), 3 * s);
+  d->ChannelsMerge();
+  if (GImGui->CurrentItemFlags & ImGuiItemFlags_Disabled) d->AddRectFilled(a, b, IM_COL32(6, 6, 14, 150), 12 * s);
+  ImGui::SetCursorScreenPos(ImVec2(top.x, bottom));
+  ImGui::Dummy(ImVec2(width, 10 * s));
+  ImGui::PopID();
+  return changed;
+}
+
+// The mascot, decoded once from the PNG built into the program (vooby_mascot.inl).
+inline ImTextureData* mascot() {
+  static ImTextureData* tex = nullptr;
+  static bool tried = false;
+  if (tried) return tex;
+  tried = true;
+  int w = 0, h = 0, c = 0;
+  unsigned char* px = stbi_load_from_memory(kVoobyMascotPng, (int)sizeof kVoobyMascotPng, &w, &h, &c, 4);
+  if (!px) return nullptr;
+  tex = new ImTextureData();
+  tex->Create(ImTextureFormat_RGBA32, w, h);
+  std::memcpy(tex->Pixels, px, (size_t)w * h * 4);
+  tex->UseColors = true;
+  ImGui::RegisterUserTexture(tex);
+  stbi_image_free(px);
+  return tex;
+}
+inline void draw_mascot(ImDrawList* d, ImVec2 a, float size) {
+  if (ImTextureData* m = mascot()) d->AddImage(m->GetTexRef(), a, ImVec2(a.x + size, a.y + size));
+}
+
+// The row on the Game page that opens the window: a wide gradient button with the status.
+inline bool entry_button() {
+  const float s = S(), w = ImGui::GetContentRegionAvail().x, h = 64 * s;
+  const bool click = ImGui::InvisibleButton("##voobymods_open", ImVec2(w, h));
+  const bool hot = ImGui::IsItemHovered() || ImGui::IsItemFocused();
+  const ImVec2 a = ImGui::GetItemRectMin(), b = ImGui::GetItemRectMax();
+  ImDrawList* d = ImGui::GetWindowDrawList();
+  const float t = ease(ImGui::GetID("##voobymods_open_hot"), hot, 14.0f);
+  grad(d, a, b, mix(IM_COL32(70, 22, 110, 255), IM_COL32(120, 36, 160, 255), t), mix(IM_COL32(24, 46, 130, 255), IM_COL32(36, 70, 190, 255), t), 14 * s);
+  d->AddRect(a, b, mix(IM_COL32(255, 255, 255, 30), IM_COL32(255, 255, 255, 170), t), 14 * s, 0, 1.3f * s);
+  draw_mascot(d, ImVec2(a.x + 10 * s, a.y + 4 * s), 56 * s);
+  const float lx = 70 * s;
+  d->AddText(settings_heading_font(), 24 * s, ImVec2(a.x + lx + 6 * s, a.y + 10 * s), kInk, "VOOBY MODS");
+  int lit = 0;
+  for (int m = 0; m < pad_mods::kCount; ++m) lit += pad_mods::enabled(m) && pad_mods::info(m).group != pad_mods::Hidden;
+  ImU32 col; const char* st = status_text(&col);
+  char line[96]; std::snprintf(line, sizeof line, "%s  \xc2\xb7  %d on", st, lit);
