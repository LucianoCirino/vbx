+  bool us_stopped = false;   // one did not get back to the ledge: no more until B is let go
+  int gj_motion = -1, gj_count = 0, gj_phase = 0;   // Falcon's gentleman: the jab seen, counted A edges, step
+  bool gj_want = false, gj_lag_seen = false;       // a next jab asked for; this jab's hitlag seen
+  float gj_last_frame = -1.0f;                     // its animation frame last time (a repeat = hitlag)
