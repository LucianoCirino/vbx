+// Vooby Mods: small, switchable rewrites of the local pad (F1 > Game > Vooby Mods).
+//
+// Each mod is a real input added to the pad inside the host's pad read, the same place Auto
+// L-cancel presses the trigger, so the game, the replay and the input display all see it as a
+// press the player made. Nothing in the fighter is written. All are off by default, and while every
+// one is off apply() does not read the game at all.
+//
+// Offline, Direct and Teams; never Ranked, Unranked or Party, and never in a vanilla-only session.
+// A real input travels like any other, so it cannot desync.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "host.h"
+
+namespace pad_mods {
+
+enum Mod : int {
+  // C-stick pushed up while the fighter is on the ground: a jump-cancelled up-smash. X goes down
+  // with the C-stick held back, then on the first jumpsquat frame the C-stick up is sent, so the
+  // jumpsquat is cancelled into the up-smash (which also works out of a run). In the air nothing
+  // changes. (The id keeps its first name so saved settings still match.)
+  CStickUpJump = 0,
+  // Fox or Falco on the ground: a fresh B press always comes out as down-B (shine). On that one
+  // frame the main stick is sent straight down; the next frame it is the player's again.
+  FoxFalcoShine = 1,
+  // Z on the ground always grabs. Z is A plus a shield press to the game, so a Z pressed a little
+  // early (landing lag, the end of a move) loses its A and leaves a light shield. After a grounded
+  // Z press that did not grab, the shield half is held with an analog press and Z is pressed again
+  // every other frame for a few frames, so the grab comes out the moment the fighter can act (a
+  // shield grab if the shield came up first). In a Fox/Falco shine, Z is a jump-cancelled grab:
+  // (once the shine takes a jump) X, then the Z one frame later, inside the jumpsquat.
+  ZAlwaysGrabs = 2,
+  // Fox or Falco in a grounded shine: L or R with the control stick forward or back wavedashes
+  // out of it. X is pressed (again, until the shine lets the jump out); on the first airborne
+  // frame L is pressed with the stick angled down toward the side the stick was held.
+  ShineWavedash = 3,
+  // Any fighter on the ground, able to jump (standing, walking, dashing, running, crouching,
+  // landing, shielding): a fresh R press is a wavedash, the same way as out of a shine. X, then
+  // their R on the first airborne frame (each fighter's own jumpsquat length, read from the disc).
+  // L is untouched, so L still shields.
+  GroundWavedash = 4,
+  // The training mods' own Auto L-cancel: the same press as the game's Auto L-cancel setting
+  // (lcancel.cpp), but its own switch and its own modes (offline, Direct and Teams). The game's
+  // setting keeps its stock behaviour.
+  // Z while dashing or running (Dash, Run, RunDirect, TurnRun, RunBrake), any fighter: a
+  // jump-cancelled grab. The jump goes in with Z kept back, and Z one frame later inside the
+  // jumpsquat (ftCo_KneeBend_IASA checks the grab): a standing grab that slides with the run instead
+  // of a dash grab (Dash and Run check the grab before the jump, so both on one frame dash-grab).
+  RunJcGrab = 5,
+  // Fox: in an air laser with B still held, every landing goes into a short hop with two lasers,
+  // on a loop while B stays held. Timing measured in the game (see pad_mods.cpp).
+  FoxLaserLoop = 6,
+  // B in shield, any fighter: up-B out of shield (a jump, then B with the stick up inside the
+  // jumpsquat), aimed by the stick held when B was pressed. B in shield stun waits for the shield.
+  ShieldUpB = 7,
+  // Fox/Falco, B in shield: shine out of shield (a jump, then down-B on the first airborne frame).
+  // Wins over ShieldUpB for Fox and Falco.
+  ShieldShine = 8,
+  // R while hanging on the ledge: a ledgedash (drop, double jump, air dodge onto the stage) on each
+  // fighter's own measured frames.
+  LedgeDash = 9,
+  // After any wavedash or waveland that slides the fighter backward (Ganondorf, Marth, Roy): holding
+  // the button or a gentle level tilt back turns into the slow forward walk that stretches the slide.
+  // Its own switch, independent of the one-button wavedash.
+  SlideStretch = 10,
+  // Not a move: the mods' own jump presses use Y instead of X.
+  JumpWithY = 11,
+  AutoLCancel = 12,
+  // Not a move of its own: the wavedash angle varies a few degrees and the stick is handed back
+  // through a halfway position like a thumb. On unless turned off.
+  HumanTiming = 13,
+  // D-pad down in an offline match: an AI plays your character until D-pad down again (the game
+  // side, shim/mu_ai_takeover.c, drives the fighter with the AI picked for that character).
+  AiTakeover = 14,
+  // Fox/Falco in a ground shine: a fresh B is the next shine of a multishine. The jump goes in (B
+  // kept back), and on the next frame, inside the jumpsquat, B with the stick down: a new grounded
+  // shine. A B before the shine takes a jump (its Start) waits for the Loop.
+  Multishine = 15,
+  // Fox/Falco hanging on the ledge with B held: up-B stalls, again and again while B stays held.
+  // Each one: a neutral frame, the stick down (drop), then B with the stick up (the up-B's startup
+  // catches the ledge again), then wait to be hanging again.
+  LedgeStall = 16,
+  // Captain Falcon: A on the ground always gives the full gentleman (jab, jab, jab), never the rapid
+  // jab: one A per jab reaches the game and A stays down through the third (a release there counts).
+  FalconGentleman = 17,
+  // Samus: down-B on the ground with B held: on landing from the bomb, the stick away and then toward
+  // the direction held (frames 41 and 42) and then at rest: a super wavedash.
+  SamusSuperWavedash = 18,
+  // X or Y (the choice) on the ground is an up-tilt: A with the stick tilted up; out of a dash or a
+  // run it crouches first, the state an up-tilt comes out of. In the air the button stays a jump.
+  UpTiltButton = 19,
+  // Zelda, B in shield: Nayru's Love out of shield (a jump, then B with the stick at rest on the
+  // first airborne frame, the same path as the shine out of shield).
+  ZeldaShieldNayru = 20,
+  // A while dashing or running, any fighter: a crouch first (the stick down), then A with the stick
+  // at rest: a jab instead of the dash attack.
+  RunJab = 21,
+  // A held through a jab, any fighter but Captain Falcon: A goes up and down every frame for them,
+  // so the jab combo (and a rapid jab, or Pikachu's repeating jab) keeps going while A stays held.
+  HoldJab = 22,
+  // Jigglypuff: the X/Y button she does not jump with, held: down-B (Rest) the moment an opponent is
+  // in Rest's range (measured in the game), B pressed every other frame until she can act.
+  JigglyRest = 23,
+  // Fox/Falco with B held: B pressed again every other frame, so the laser loops on the ground and in
+  // the air, and a new laser starts whenever one ends (standing, walking, crouching, jumping, falling).
+  HoldLaser = 24,
+  kCount
+};
+
+// Menu groups (F1 > Game > Vooby Mods): each its own sub menu.
+enum Group : int { AllCharacters = 0, FoxFalco = 1, Options = 2, AiGroup = 3, FalconSamus = 4, kGroupCount, Hidden = -1 };
+const char* group_name(int group);
+
+struct Info {
+  const char* ini_key;   // port-settings.ini key, "padmod_<name>"
+  const char* label;     // settings row: a short title
+  const char* summary;   // one muted line under it
+  const char* help;      // tooltip
+  int group;             // Group
+};
+const Info& info(int mod);
+
+// The master switch (F1 > Vooby Mods, ini padmod_all): off, no mod does anything; every mod's own
+// switch and settings are kept for when it is turned back on. On unless saved off.
+void set_all_enabled(bool on);
+bool all_enabled();
+void set_enabled(int mod, bool on);
+// Per-mod button choices (F1 sub options, ini padmod_<name>_trigger / _jump).
+// Trigger: 0 R, 1 L, 2 either, for the mods that use a shoulder button (has_trigger_choice).
+// Jump: 0 X, 1 Y, for the mods that press a jump (has_jump_choice).
+bool has_trigger_choice(int mod);
+bool has_jump_choice(int mod);
+int trigger_choice(int mod);
+void set_trigger_choice(int mod, int choice);
+int jump_choice(int mod);
+// A mod's one on/off sub option (ini padmod_<name>_sub), shown under it while it is on.
+const char* sub_option_label(int mod);   // nullptr: none
+bool sub_option(int mod);
+void set_sub_option(int mod, bool on);
+void set_jump_choice(int mod, int choice);
+bool enabled(int mod);
+bool any_enabled();
+// Off in matchmaking modes or a vanilla-only session, whatever the saved choice.
+bool allowed_now();
+bool mode_allowed(int slippi_mode);
+
+// ---- AI takeover (AiTakeover) ----
+// Characters by the game's internal fighter kind (0 Mario .. 26 Roy); the AI picked for each:
+// kAiDefault (the pro AI who plays it if there is one, else the "Balanced" practice CPU),
+// 0..7 a practice CPU style (mu_pc_preset), or 0x80 | pro (MU_PC_PRESET_PRO).
+constexpr int kAiKinds = 27;
+constexpr int kAiDefault = -1;
+const char* ai_kind_name(int kind);   // "" for kinds not offered (Nana, Master Hand...)
+int ai_choice(int kind);
+void set_ai_choice(int kind, int choice);
+// Whether an AI is playing for this controller now (D-pad down flips it; offline matches only).
+bool ai_active(int port);
+// D-pad left/right while an AI plays: the player's request to switch its target (-1 previous,
+// +1 next, 0 none), taken once by the AI driver.
+int take_ai_target_step(int port);
+// The AI's controller for a port (ai_takeover.cpp registers it; the unit tests run without one).
+using AiDriver = bool (*)(int port, host::PadState& out);
+void set_ai_driver(AiDriver driver);
+
+// Called with the freshly polled pads, after lcancel::apply and before the game reads them.
+void apply(host::PadState pads[4]);
+
+}  // namespace pad_mods
