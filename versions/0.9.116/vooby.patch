@@ -0,0 +1,49 @@
+// Vooby Mods' AI takeover (pad_mods.h AiTakeover): an AI plays a player's fighter by writing that
+// controller's pad, the same way every other Vooby Mod adds presses, so the game library is the
+// release's own and nothing inside the match changes (a library built here would desync online).
+//
+// What the AI sees is what the replay records after each frame (the post-frame event, the same
+// numbers the pro AI was trained on): source_host hands every replay event to note_event. Each pad
+// read, drive() answers with the controller for that port from the AI picked for its character:
+// a practice CPU style (the practice CPU's model, mu_pc_frame) or a pro AI (ghost_ai::act), one
+// frame behind like the game-side AIs.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+#include "host.h"
+
+namespace ai_takeover {
+
+// Every replay event the game sends (Game Start resets, post-frames are kept per player).
+void note_event(uint8_t command, const uint8_t* payload, uint32_t size);
+// Training and offline matches with replay saving off record no replay, so no post-frames come:
+// then the host's state snapshot stands in for them (position, speed, action, percent, facing and
+// stocks; hitstun, jumps and air or ground worked out). One per pad read, before drive().
+struct SnapFighter {
+  bool present = false, airborne = false, air_known = false;
+  int kind = 0;   // internal fighter kind (Ft_Kind)
+  int port = -1;  // the controller playing it (Training and 1P modes put the player in slot 1 whatever the port)
+  int action = 0, stocks = 0;
+  float x = 0, y = 0, vx = 0, vy = 0, anim = 0, percent = 0, facing = 1;
+};
+void note_snapshot(const SnapFighter (&slots)[4], int internal_stage);
+
+// The AI a character gets: the choice saved (pad_mods::ai_choice) when it can play, else the pro who
+// plays that character when that pro's file loaded, else the Balanced practice CPU (0).
+int pick(int kind);
+// Offline, which player slot a controller plays and which controller a slot's fighter is on (from
+// the snapshot; the same number when none is known, as in a VS match).
+// The badge's name for the AI playing controller `port`: the pro's first name, or "CPU" (the
+// practice CPU); "" before it has played.
+const char* label(int port);
+// The player slot the AI on controller `port` is after (-1 none), for the target marker.
+int target_slot(int port);
+int slot_of_port(int port);
+// The team of a player slot in a teams match (from the replay's Game Start), -1 otherwise.
+int team_of(int slot);
+int port_of_slot(int slot);
+// The controller an AI holds this frame for the fighter on controller `port`. False: nothing to
+// play (no match, no fighter on that port yet); the player's own pad stays.
+bool drive(int port, host::PadState& out);
+
+}  // namespace ai_takeover
